    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "from typing import Optional, Tuple\n",
        "\n",
        "# --- Final Robust Implementation of the Model Architecture ---\n",
        "\n",
        "class CombinedPolicyForecastingBase(GraphProcessingBase): # Re-evaluating this class to pick up GraphProcessingBase fix\n",
        "    def __init__(self, observation_spec, action_spec, hidden_rnn_dim, gcn_hidden_dim, num_agents, input_x_dim, num_action_categories, num_individual_actions_features, forecast_horizon, device, num_gcn_layers, num_rnn_layers):\n",
        "        graph_attr_dim = observation_spec[\"agents\", \"data\", \"graph_attributes\"].shape[-1]\n",
        "        super().__init__(input_x_dim, gcn_hidden_dim, hidden_rnn_dim, num_agents, graph_attr_dim, device, num_gcn_layers, num_rnn_layers)\n",
        "\n",
        "        self.num_action_categories = num_action_categories\n",
        "        self.num_individual_actions_features = num_individual_actions_features\n",
        "        self.forecast_horizon = forecast_horizon\n",
        "\n",
        "        # Policy head: Maps GRU output to action logits\n",
        "        self.action_head = nn.Linear(hidden_rnn_dim, num_agents * num_individual_actions_features * num_action_categories)\n",
        "\n",
        "        # Forecasting head: Maps GRU output to price forecasts\n",
        "        self.forecast_head = nn.Linear(hidden_rnn_dim, num_agents * forecast_horizon)\n",
        "\n",
        "    def forward(self, x, edge_index, batch_nodes, time, graph_attributes, hidden_state_in=None):\n",
        "        # Use the shared graph + RNN backbone defined in GraphProcessingBase\n",
        "        # This method now correctly handles both [Agents, Feats] and [Batch, Agents, Feats]\n",
        "        gru_output, h_out = self._process_graph_and_rnn(x, edge_index, time, graph_attributes, hidden_state_in)\n",
        "\n",
        "        # Identify the leading dimensions (batch/time) from the GRU output\n",
        "        # gru_output shape is [Batch*Time, Hidden] or [Hidden] depending on input ndim\n",
        "        if gru_output.ndim == 1:\n",
        "            # Unbatched case (e.g. env.reset)\n",
        "            logits = self.action_head(gru_output).view(1, -1, self.num_agents * self.num_individual_actions_features * self.num_action_categories)\n",
        "            forecast = self.forecast_head(gru_output).view(1, -1, self.num_agents, self.forecast_horizon)\n",
        "        else:\n",
        "            # Batched case\n",
        "            logits = self.action_head(gru_output).view(x.shape[0], -1, self.num_agents * self.num_individual_actions_features * self.num_action_categories)\n",
        "            forecast = self.forecast_head(gru_output).view(x.shape[0], -1, self.num_agents, self.forecast_horizon)\n",
        "\n",
        "        forecast = forecast.transpose(-1, -2)\n",
        "\n",
        "        return logits, forecast, h_out\n"
      ],
      "metadata": {
        "id": "lKbS4RTHzv75"
      },
      "execution_count": null,
      "outputs": []
    },
