        "import torch\n",
        "import numpy as np\n",
        "from torchrl.data import Composite, Unbounded\n",
        "\n",
        "print(\"Instantiating CombinedPolicyForecastingBase model...\")\n",
        "\n",
        "combined_model = CombinedPolicyForecastingBase(\n",
        "    observation_spec=observation_spec,\n",
        "    action_spec=action_spec,\n",
        "    hidden_rnn_dim=hidden_rnn_dim,\n",
        "    gcn_hidden_dim=gcn_hidden_dim,\n",
        "    num_agents=num_agents,\n",
        "    input_x_dim=input_x_dim,\n",
        "    num_action_categories=num_action_categories,\n",
        "    num_individual_actions_features=num_individual_actions_features,\n",
        "    forecast_horizon=forecast_horizon,\n",
        "    device=device,\n",
        "    num_gcn_layers=num_gcn_layers,\n",
        "    num_rnn_layers=num_rnn_layers\n",
        ").to(device)\n",
        "\n",
        "print(\"CombinedPolicyForecastingBase model instantiated successfully.\")\n",
        "\n",
        "# --- Test Environment and Model Interaction ---\n",
        "\n",
        "print(\"Resetting environment...\")\n",
        "rollout_tensordict = env.reset()\n",
        "print(\"Environment reset. Initial observation:\")\n",
        "\n",
        "max_steps = 3\n",
        "\n",
        "for step in range(max_steps):\n",
        "    print(f\"\\n--- Step {step + 1}/{max_steps} ---\")\n",
        "\n",
        "    # Extract current observation features\n",
        "    x = rollout_tensordict.get((\"agents\", \"data\", \"x\"))\n",
        "    edge_index = rollout_tensordict.get((\"agents\", \"data\", \"edge_index\"))\n",
        "    batch_nodes = rollout_tensordict.get((\"agents\", \"data\", \"batch\"))\n",
        "    time = rollout_tensordict.get((\"agents\", \"data\", \"time\"))\n",
        "    graph_attributes = rollout_tensordict.get((\"agents\", \"data\", \"graph_attributes\"))\n",
        "    hidden_state_in = rollout_tensordict.get(\"hidden_state\")\n",
        "\n",
        "    # Model forward pass\n",
        "    with torch.no_grad():\n",
        "        logits, forecast, h_out = combined_model(\n",
        "            x=x,\n",
        "            edge_index=edge_index,\n",
        "            batch_nodes=batch_nodes,\n",
        "            time=time,\n",
        "            graph_attributes=graph_attributes,\n",
        "            hidden_state_in=hidden_state_in\n",
        "        )\n",
        "\n",
        "    # Sampling actions\n",
        "    action_dist = Custom_MultiCategorical(\n",
        "        logits=logits,\n",
        "        nvec=action_spec.get((\"agents\", \"action\")).nvec,\n",
        "        num_agents=num_agents,\n",
        "        num_individual_actions_features=num_individual_actions_features\n",
        "    )\n",
        "    action_sampled = action_dist.sample()\n",
        "\n",
        "    # Prepare tensordict for env.step\n",
        "    rollout_tensordict.set((\"agents\", \"action\"), action_sampled)\n",
        "    rollout_tensordict.set((\"agents\", \"logits\"), logits)\n",
        "    rollout_tensordict.set(\"hidden_state\", h_out.clone())\n",
        "    rollout_tensordict.set(\"forecast\", forecast.clone())\n",
        "\n",
        "    # Step the environment\n",
        "    # rollout_tensordict now contains the transition: keys like \"reward\" and \"done\" are inside \"next\"\n",
        "    rollout_tensordict = env.step(rollout_tensordict)\n",
        "\n",
        "    # Correctly access reward and done from the 'next' entry\n",
        "    reward_tensor = rollout_tensordict.get((\"next\", \"reward\"))\n",
        "    done_tensor = rollout_tensordict.get((\"next\", \"done\"))\n",
        "\n",
        "    print(f\"Generated action (first 5 values): {action_sampled.flatten()[:5].tolist()}\")\n",
        "    print(f\"Raw Environment reward tensor: {reward_tensor}\")\n",
        "\n",
        "    if reward_tensor is not None:\n",
        "        print(f\"Environment reward: {reward_tensor.item():.8f}\")\n",
        "    else:\n",
        "        print(\"Environment reward: Not found in 'next' key\")\n",
        "\n",
        "    if done_tensor.item():\n",
        "        print(\"Episode finished.\")\n",
        "        break\n",
        "\n",
        "    # Crucial for manual loops: step to the next observation\n",
        "    from torchrl.envs.utils import step_mdp\n",
        "    rollout_tensordict = step_mdp(rollout_tensordict)\n",
        "\n",
        "print(\"\\nTest script finished.\")"
