      "source": [
        "import torch\n",
        "\n",
        "class PipelineManager:\n",
        "    \"\"\"Consolidates environment setup, model building, and weight loading into a single workflow.\"\"\"\n",
        "    def __init__(self, config: dict, device: torch.device):\n",
        "        self.config = config\n",
        "        self.device = device\n",
        "        self.env = None\n",
        "        self.actor = None\n",
        "        self.forecaster = None\n",
        "        self.critic = None\n",
        "        self.env_model = None\n",
        "\n",
        "    def setup_all(self, data_preprocessor):\n",
        "        print(\"Configuring Environment...\")\n",
        "        self.env, actual_agents, input_dim = setup_environment(\n",
        "            node_features_tensors_dict=data_preprocessor.node_features_tensors,\n",
        "            graph_attributes_tensor=data_preprocessor.graph_attributes_tensor,\n",
        "            forecast_horizon=self.config['forecast_horizon'],\n",
        "            device=self.device,\n",
        "            force_data_reload=False,\n",
        "            max_dataset_size=None,\n",
        "            num_envs=self.config['num_envs'],\n",
        "            seed=self.config['seed'],\n",
        "            episode_length=self.config['episode_length'],\n",
        "            num_individual_actions_features=self.config['num_actions'],\n",
        "            num_action_categories=self.config['num_categories'],\n",
        "            hidden_rnn_dim=self.config['h_dim'],\n",
        "            num_rnn_layers=self.config['n_rnn'],\n",
        "            allow_repeat_data=True\n",
        "        )\n",
        "\n",
        "        print(\"Building Models...\")\n",
        "        self.actor, self.forecaster, self.critic = build_models(\n",
        "            self.env.observation_spec, self.env.action_spec,\n",
        "            self.config['h_dim'], self.config['g_dim'],\n",
        "            actual_agents, input_dim,\n",
        "            self.config['num_categories'], self.config['num_actions'],\n",
        "            self.config['forecast_horizon'], self.device,\n",
        "            self.config['n_gcn'], self.config['n_rnn']\n",
        "        )\n",
        "\n",
        "        self.env_model = EnvDynamicsModel(\n",
        "            observation_spec=self.env.observation_spec,\n",
        "            action_spec=self.env.action_spec,\n",
        "            hidden_rnn_dim=self.config['h_dim'],\n",
        "            gcn_hidden_dim=self.config['g_dim'],\n",
        "            num_agents=actual_agents,\n",
        "            input_x_dim=input_dim,\n",
        "            device=self.device,\n",
        "            num_gcn_layers=self.config['n_gcn'],\n",
        "            num_rnn_layers=self.config['n_rnn']\n",
        "        ).to(self.device)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "import wandb\n",
        "# Import userdata from google.colab to securely access API key\n",
        "from google.colab import userdata\n",
        "\n",
        "# Retrieve WANDB_API_KEY from Colab Secrets\n",
        "import kagglehub\n",
        "nanayaw56_combined_fuel_data_path = kagglehub.dataset_download('rsarpongstreetor/combine-fuel-data-date-formated')\n",
        "\n",
        "import wandb\n",
        "wandb.login(key=\"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\")\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import torch\n",
        "from typing import Optional\n",
        "from scipy.stats import zscore\n",
        "import os\n",
        "import glob\n",
        "\n",
        "\n",
        "data_path = nanayaw56_combined_fuel_data_path\n",
        "\n",
        "class DataPreprocessor:\n",
        "    def __init__(self, data_path: str, device: torch.device, start_date: str = '2017-01-01', end_date: Optional[str] = '2025-06-30'):\n",
        "        self.data_path = data_path\n",
        "        self.device = device\n",
        "        self.start_date = start_date\n",
        "        self.end_date = end_date\n",
        "        self.merged_df = None\n",
        "        self.node_features_tensors = None\n",
        "        self.graph_attributes_tensor = None\n",
        "        self.normalization_params = {}\n",
        "        self.node_cols_map = None\n",
        "        self._process_data()\n",
        "\n",
        "    def _load_and_clean_dataframe(self) -> pd.DataFrame:\n",
        "        actual_data_file_path = self.data_path\n",
        "        if os.path.isdir(self.data_path):\n",
        "            csv_files = glob.glob(os.path.join(self.data_path, '*.csv'))\n",
        "            actual_data_file_path = csv_files[0]\n",
        "\n",
        "        df = pd.read_csv(actual_data_file_path, low_memory=False)\n",
        "        date_col = 'Date' if 'Date' in df.columns else 'Unnamed: 0'\n",
        "        df[date_col] = pd.to_datetime(df[date_col], errors='coerce')\n",
        "        df.dropna(subset=[date_col], inplace=True)\n",
        "        df.set_index(date_col, inplace=True)\n",
        "        df.sort_index(inplace=True)\n",
        "\n",
        "        mask = (df.index >= pd.to_datetime(self.start_date)) & (df.index <= pd.to_datetime(self.end_date))\n",
        "        df = df.loc[mask].copy()\n",
        "\n",
        "        print(f\"Data filtered. Rows found: {len(df)} for range {self.start_date} to {self.end_date}\")\n",
        "        if df.empty:\n",
        "            raise ValueError(f\"No data found between {self.start_date} and {self.end_date}. Check the dataset date range.\")\n",
        "\n",
        "        df.ffill(inplace=True)\n",
        "        df.bfill(inplace=True)\n",
        "\n",
        "        for col in df.columns:\n",
        "            df[col] = pd.to_numeric(df[col], errors='coerce')\n",
        "        df.fillna(df.mean(numeric_only=True), inplace=True)\n",
        "\n",
        "        df = df.clip(lower=1e-6)\n",
        "        df_returns = np.log(df).diff().shift(-1)\n",
        "\n",
        "        # Fill any remaining NaNs after calculating returns (e.g., from diff() or shift(-1)) with 0\n",
        "        # This prevents dropping entire time steps if only a few features have NaNs.\n",
        "        df_returns.fillna(0, inplace=True)\n",
        "\n",
        "        print(f\"DataFrame after filling NaNs in returns: {len(df_returns)} rows, {df_returns.isnull().sum().sum()} NaNs total\")\n",
        "\n",
        "        return df_returns\n",
        "\n",
        "    def _normalize_data(self, df: pd.DataFrame) -> pd.DataFrame:\n",
        "        numeric_cols = df.select_dtypes(include=np.number).columns\n",
        "        for col in numeric_cols:\n",
        "            self.normalization_params[col] = {'mean': df[col].mean(), 'std': df[col].std()}\n",
        "            df[col] = zscore(df[col]) if df[col].std() > 1e-9 else 0.0\n",
        "        return df\n",
        "\n",
        "    def _process_data(self):\n",
        "        df = self._load_and_clean_dataframe()\n",
        "        self.merged_df = self._normalize_data(df.copy())\n",
        "        self.node_features_tensors = {}\n",
        "        node_prefix_map = {'EER_EP': 'USA', 'MYS_': 'Malaysia', 'EU_': 'European Union', 'AUS_': 'Australia', 'CHL_': 'Chile', 'LSO_': 'Lesotho', 'MDG_': 'Madagascar', 'GHA_': 'Ghana'}\n",
        "        self.node_cols_map = {name: [] for name in set(node_prefix_map.values())}\n",
        "        for col in self.merged_df.columns:\n",
        "            for prefix, node_name in node_prefix_map.items():\n",
        "                if col.startswith(prefix): self.node_cols_map[node_name].append(col)\n",
        "\n",
        "        print(f\"Node columns map: {self.node_cols_map}\")\n",
        "\n",
        "        for node_name, cols in self.node_cols_map.items():\n",
        "            if cols:\n",
        "                tensor_data = self.merged_df[cols].values\n",
        "                if tensor_data.shape[0] == 0:\n",
        "                    print(f\"WARNING: Node '{node_name}' has 0 rows after feature selection and processing.\")\n",
        "                self.node_features_tensors[node_name] = torch.tensor(tensor_data, dtype=torch.float32, device=self.device)\n",
        "                print(f\"  Node '{node_name}' tensor shape: {self.node_features_tensors[node_name].shape}\")\n",
        "            else:\n",
        "                print(f\"  Node '{node_name}' has no matching columns in the dataframe.\")\n",
        "\n",
        "        if not self.node_features_tensors:\n",
        "            raise ValueError(\"node_features_tensors_dict is empty after processing. No features found for any node.\")\n",
        "\n",
        "        oil_cols = [c for c in ['Brent', 'WTI', 'OPEC'] if c in self.merged_df.columns]\n",
        "        if not oil_cols:\n",
        "            raise ValueError(\"No oil price columns (Brent, WTI, OPEC) found in the processed data.\")\n",
        "        self.graph_attributes_tensor = torch.tensor(self.merged_df[oil_cols].values, dtype=torch.float32, device=self.device)\n",
        "        print(f\"Graph attributes tensor shape: {self.graph_attributes_tensor.shape}\")\n",
        "\n",
        "if 'device' not in globals():\n",
        "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "\n",
        "data_preprocessor = DataPreprocessor(data_path, device)\n",
        "print('DataPreprocessor updated and validated.')"
      ],
