    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import multiprocessing as mp\n",
        "from tensordict import TensorDict\n",
        "from tensordict.nn import TensorDictModule\n",
        "from torchrl.modules import ProbabilisticActor, OneHotCategorical\n",
        "import os\n",
        "\n",
        "try:\n",
        "    mp.set_start_method(\"spawn\", force=True)\n",
        "except RuntimeError:\n",
        "    pass\n",
        "\n",
        "input_dim_for_policy_net = input_x_dim + fuel_graph.graph_attributes_tensor.shape[-1]\n",
        "\n",
        "# Ensure these variables are in scope for the f-string\n",
        "current_num_agents = num_agents\n",
        "current_num_individual_actions_features = num_individual_actions_features\n",
        "current_num_action_categories = num_action_categories\n",
        "current_forecast_horizon = forecast_horizon\n",
        "current_data_path = data_path\n",
        "\n",
        "script_content = f\"\"\"\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy.stats import zscore\n",
        "import glob\n",
        "import os\n",
        "from typing import Optional\n",
        "from tensordict import TensorDict\n",
        "from tensordict.nn import TensorDictModule\n",
        "from torchrl.modules import ProbabilisticActor, OneHotCategorical\n",
        "from torchrl.envs import EnvBase\n",
        "from torchrl.data import Composite, Unbounded, MultiCategorical\n",
        "\n",
        "class DataPreprocessor:\n",
        "    def __init__(self, data_path, start_date='2017-01-01', end_date='2025-06-30'):\n",
        "        self.data_path = data_path\n",
        "        self.start_date = start_date\n",
        "        self.end_date = end_date\n",
        "        self._process_data()\n",
        "\n",
        "    def _process_data(self):\n",
        "        actual_path = self.data_path\n",
        "        if os.path.isdir(self.data_path):\n",
        "            csv_files = glob.glob(os.path.join(self.data_path, '*.csv'))\n",
        "            if not csv_files:\n",
        "                raise FileNotFoundError(f\\\"No CSV files found in {{self.data_path}}\\\")\n",
        "            actual_path = csv_files[0]\n",
        "        df = pd.read_csv(actual_path, low_memory=False)\n",
        "        date_col = 'Date' if 'Date' in df.columns else 'Unnamed: 0'\n",
        "        df[date_col] = pd.to_datetime(df[date_col], errors='coerce')\n",
        "        df.dropna(subset=[date_col], inplace=True)\n",
        "        df.set_index(date_col, inplace=True)\n",
        "        df.sort_index(inplace=True)\n",
        "        mask = (df.index >= pd.to_datetime(self.start_date)) & (df.index <= pd.to_datetime(self.end_date))\n",
        "        df = df.loc[mask].copy()\n",
        "        df.ffill(inplace=True); df.bfill(inplace=True)\n",
        "        for col in df.columns: df[col] = pd.to_numeric(df[col], errors='coerce')\n",
        "        df.fillna(df.mean(numeric_only=True), inplace=True)\n",
        "        df_returns = np.log(df.clip(lower=1e-6)).diff().shift(-1).fillna(0)\n",
        "        for col in df_returns.select_dtypes(include=np.number).columns:\n",
        "            df_returns[col] = zscore(df_returns[col]) if df_returns[col].std() > 1e-9 else 0.0\n",
        "        self.merged_df = df_returns\n",
        "        self.node_features_tensors = {{}}\n",
        "        prefix_map = {{'EER_EP': 'USA', 'MYS_': 'Malaysia', 'EU_': 'European Union', 'AUS_': 'Australia', 'CHL_': 'Chile', 'LSO_': 'Lesotho', 'MDG_': 'Madagascar', 'GHA_': 'Ghana'}}\n",
        "        for prefix, name in prefix_map.items():\n",
        "            cols = [c for c in self.merged_df.columns if c.startswith(prefix)]\n",
        "            if cols: self.node_features_tensors[name] = torch.tensor(self.merged_df[cols].values, dtype=torch.float32)\n",
        "        oil_cols = [c for c in ['Brent', 'WTI', 'OPEC'] if c in self.merged_df.columns]\n",
        "        self.graph_attributes_tensor = torch.tensor(self.merged_df[oil_cols].values, dtype=torch.float32)\n",
        "\n",
        "class FuelpriceenvfeatureGraph:\n",
        "    def __init__(self, preprocessor, forecast_horizon):\n",
        "        self.node_features_tensors_dict = preprocessor.node_features_tensors\n",
        "        self.graph_attributes_tensor = preprocessor.graph_attributes_tensor\n",
        "        self.forecast_horizon = forecast_horizon\n",
        "        self.num_total_time_steps = next(iter(self.node_features_tensors_dict.values())).shape[0]\n",
        "        self.node_map = {{name: i for i, name in enumerate(sorted(self.node_features_tensors_dict.keys()))}}\n",
        "        self.num_agents = len(self.node_map)\n",
        "        self.max_feat_dim = max(t.shape[1] for t in self.node_features_tensors_dict.values())\n",
        "        edge_list = [[i, j] for i in range(self.num_agents) for j in range(self.num_agents) if i != j]\n",
        "        self.edge_index = torch.tensor(edge_list, dtype=torch.long).t().contiguous()\n",
        "\n",
        "    def get_processed_data_tensor(self):\n",
        "        all_data = []\n",
        "        for i in range(self.num_total_time_steps):\n",
        "            padded = [torch.cat([self.node_features_tensors_dict[n][i], torch.zeros(self.max_feat_dim - self.node_features_tensors_dict[n][i].shape[0])]) for n in sorted(self.node_map.keys())]\n",
        "            td = TensorDict({{\"agents\": TensorDict({{\"data\": TensorDict({{\"x\": torch.stack(padded), \"edge_index\": self.edge_index, \"batch\": torch.zeros(self.num_agents, dtype=torch.long), \"time\": torch.tensor([i]), \"graph_attributes\": self.graph_attributes_tensor[i]}}, batch_size=[])}}, batch_size=[])}}, batch_size=[])\n",
        "            all_data.append(td)\n",
        "        return torch.stack(all_data, 0)\n",
        "\n",
        "class AnFuelpriceEnv(EnvBase):\n",
        "    def __init__(self, data_tensor, episode_length, num_agents, num_individual_actions_features, num_action_categories, hidden_rnn_dim, num_rnn_layers, forecast_horizon):\n",
        "        super().__init__(device=torch.device('cpu'), batch_size=torch.Size([1]))\n",
        "        self.data_tensor, self.episode_length = data_tensor, episode_length\n",
        "        self.num_agents, self.num_individual_actions_features = num_agents, num_individual_actions_features\n",
        "        self.num_action_categories, self.forecast_horizon = num_action_categories, forecast_horizon\n",
        "        self.hidden_rnn_dim, self.num_rnn_layers = hidden_rnn_dim, num_rnn_layers\n",
        "        x_dim = self.data_tensor.get((\"agents\", \"data\", \"x\")).shape[-1]\n",
        "\n",
        "        self.observation_spec = Composite(\n",
        "            agents=Composite(\n",
        "                data=Composite(\n",
        "                    x=Unbounded(shape=(1, num_agents, x_dim)),\n",
        "                    edge_index=Unbounded(shape=(1, 2, 56), dtype=torch.long),\n",
        "                    batch=Unbounded(shape=(1, num_agents), dtype=torch.long),\n",
        "                    time=Unbounded(shape=(1, 1), dtype=torch.long),\n",
        "                    graph_attributes=Unbounded(shape=(1, 3))\n",
        "                , shape=(1,)),\n",
        "            shape=(1,)),\n",
        "            hidden_state=Unbounded(shape=(1, 1, 1, hidden_rnn_dim)),\n",
        "            forecast=Unbounded(shape=(1, forecast_horizon, num_agents)),\n",
        "            profit_term_mean=Unbounded(shape=(1, 1)),\n",
        "            volatility_term_mean=Unbounded(shape=(1, 1)),\n",
        "            forecast_term_mean=Unbounded(shape=(1, 1)),\n",
        "            graph_term_global_mean=Unbounded(shape=(1, 1))\n",
        "        , shape=(1,))\n",
        "\n",
        "        action_dim = num_agents * num_individual_actions_features\n",
        "        self.action_spec = Composite(\n",
        "            agents=Composite(\n",
        "                action=MultiCategorical(nvec=[num_action_categories]*action_dim, shape=(1, action_dim))\n",
        "            , shape=(1,))\n",
        "        , shape=(1,))\n",
        "\n",
        "        self.reward_spec = Unbounded(shape=(1, 1))\n",
        "        self.done_spec = Composite(done=Unbounded(shape=(1, 1), dtype=torch.bool), shape=(1,))\n",
        "\n",
        "    def _reset(self, td=None):\n",
        "        self.current_step = 0\n",
        "        self.start_idx = torch.randint(0, self.data_tensor.shape[0] - self.episode_length - 20, (1,)).item()\n",
        "        obs = self.data_tensor[self.start_idx].clone().expand(1).to_tensordict()\n",
        "        obs.update({{\n",
        "            \"hidden_state\": torch.zeros(1, 1, 1, self.hidden_rnn_dim),\n",
        "            \"forecast\": torch.zeros(1, self.forecast_horizon, self.num_agents),\n",
        "            \"profit_term_mean\": torch.zeros(1, 1),\n",
        "            \"volatility_term_mean\": torch.zeros(1, 1),\n",
        "            \"forecast_term_mean\": torch.zeros(1, 1),\n",
        "            \"graph_term_global_mean\": torch.zeros(1, 1)\n",
        "        }})\n",
        "        return obs\n",
        "\n",
        "    def _step(self, td):\n",
        "        curr_x = td.get((\"agents\", \"data\", \"x\"))\n",
        "        self.current_step += 1\n",
        "        out = self.data_tensor[self.start_idx + self.current_step].clone().expand(1).to_tensordict()\n",
        "\n",
        "        # 1. Metric Computations\n",
        "        next_x = out.get((\"agents\", \"data\", \"x\"))\n",
        "        profit = next_x[..., 0] - curr_x[..., 0]\n",
        "        volatility = profit ** 2\n",
        "\n",
        "        # MSE Logic: compare previous forecast to current actual price\n",
        "        prev_forecast = td.get(\"forecast\")\n",
        "        forecast_err = (prev_forecast[..., 0, :] - next_x[..., 0]) ** 2\n",
        "\n",
        "        # Graph Logic\n",
        "        edge_idx = out.get((\"agents\", \"data\", \"edge_index\"))\n",
        "        s_p = profit.gather(-1, edge_idx[:, 0, :])\n",
        "        t_p = profit.gather(-1, edge_idx[:, 1, :])\n",
        "        graph_div = ((s_p - t_p) ** 2).mean(dim=-1, keepdim=True)\n",
        "\n",
        "        # 2. Reward & Output Keys\n",
        "        reward = (profit.mean() - 0.1 * volatility.mean() - 0.1 * forecast_err.mean() - 0.1 * graph_div).view(1, 1)\n",
        "        done = torch.tensor([[self.current_step >= self.episode_length]])\n",
        "\n",
        "        out.update({{\n",
        "            \"reward\": reward,\n",
        "            \"done\": done,\n",
        "            \"terminated\": done,\n",
        "            \"truncated\": torch.zeros_like(done),\n",
        "            \"hidden_state\": td[\"hidden_state\"].clone(),\n",
        "            \"forecast\": td[\"forecast\"].clone(),\n",
        "            \"profit_term_mean\": profit.mean(dim=-1, keepdim=True),\n",
        "            \"volatility_term_mean\": volatility.mean(dim=-1, keepdim=True),\n",
        "            \"forecast_term_mean\": forecast_err.mean(dim=-1, keepdim=True),\n",
        "            \"graph_term_global_mean\": graph_div\n",
        "        }})\n",
        "        return out\n",
        "\n",
        "    def _set_seed(self, seed): torch.manual_seed(seed) if seed is not None else None\n",
        "\n",
        "class PolicyForecasterNet(nn.Module):\n",
        "    def __init__(self, input_dim={input_dim_for_policy_net}, hidden_dim=64):\n",
        "        super().__init__()\n",
        "        self.backbone = nn.Sequential(nn.Linear(input_dim, hidden_dim), nn.ReLU())\n",
        "        self.gru = nn.GRU(hidden_dim, hidden_dim, batch_first=True)\n",
        "        self.action_head = nn.Linear(hidden_dim, {current_num_agents * current_num_individual_actions_features * current_num_action_categories})\n",
        "        self.forecast_head = nn.Linear(hidden_dim, {current_num_agents * current_forecast_horizon})\n",
        "\n",
        "    def forward(self, x, edge_index, batch_nodes, time, graph_attributes, hidden_state_in=None):\n",
        "        x_mean = x.mean(dim=-2)\n",
        "        x_in = torch.cat([x_mean, graph_attributes], dim=-1)\n",
        "        feat = self.backbone(x_in)\n",
        "        gru_out, h_out = self.gru(feat.unsqueeze(1), hidden_state_in.squeeze(2).permute(1,0,2) if hidden_state_in is not None else None)\n",
        "        logits = self.action_head(gru_out.squeeze(1))\n",
        "        forecast = self.forecast_head(gru_out.squeeze(1)).view(-1, {current_forecast_horizon}, {current_num_agents})\n",
        "        return logits, forecast, h_out.permute(1,0,2).unsqueeze(2)\n",
        "\n",
        "def env_factory():\n",
        "    dp = DataPreprocessor(data_path='{current_data_path}')\n",
        "    fg = FuelpriceenvfeatureGraph(dp, forecast_horizon={current_forecast_horizon})\n",
        "    return AnFuelpriceEnv(fg.get_processed_data_tensor(), episode_length=50, num_agents={current_num_agents}, num_individual_actions_features={current_num_individual_actions_features}, num_action_categories={current_num_action_categories}, hidden_rnn_dim=64, num_rnn_layers=1, forecast_horizon={current_forecast_horizon})\n",
        "\n",
        "def make_policy():\n",
        "    base_net = PolicyForecasterNet()\n",
        "    module = TensorDictModule(\n",
        "        module=base_net,\n",
        "        in_keys=[(\"agents\", \"data\", \"x\"), (\"agents\", \"data\", \"edge_index\"), (\"agents\", \"data\", \"batch\"), (\"agents\", \"data\", \"time\"), (\"agents\", \"data\", \"graph_attributes\"), \"hidden_state\"],\n",
        "        out_keys=[(\"agents\", \"logits\"), \"forecast\", \"hidden_state\"]\n",
        "    )\n",
        "    actor = ProbabilisticActor(\n",
        "        module=module,\n",
        "        in_keys=[(\"agents\", \"logits\")],\n",
        "        out_keys=[(\"agents\", \"action\")],\n",
        "        distribution_class=OneHotCategorical,\n",
        "        return_log_prob=True\n",
        "    )\n",
        "    return actor\n",
        "\"\"\"\n",
        "\n",
        "with open(\"worker_env_isolated.py\", \"w\") as f:\n",
        "    f.write(script_content)\n",
        "\n",
        "import worker_env_isolated\n",
        "import importlib\n",
        "importlib.reload(worker_env_isolated)\n",
        "\n",
        "print(\"worker_env_isolated.py updated with fixed metrics and reloaded.\")"
      ],
      "metadata": {
