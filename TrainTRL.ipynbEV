      "source": [
        "import torch\n",
        "from tensordict import TensorDict, TensorDictBase\n",
        "from torchrl.envs import EnvBase\n",
        "from typing import Optional\n",
        "from torchrl.data import Composite, Unbounded, MultiCategorical\n",
        "\n",
        "class FuelpriceenvfeatureGraph:\n",
        "    def __init__(self, node_features_tensors_dict: dict[str, torch.Tensor], graph_attributes_tensor: torch.Tensor, forecast_horizon: int, device: torch.device):\n",
        "        if not node_features_tensors_dict:\n",
        "            raise ValueError(\"node_features_tensors_dict cannot be empty.\")\n",
        "\n",
        "        first_node_tensor = next(iter(node_features_tensors_dict.values()))\n",
        "        self.num_total_time_steps = first_node_tensor.shape[0]\n",
        "        self.node_features_tensors_dict = node_features_tensors_dict\n",
        "        self.graph_attributes_tensor = graph_attributes_tensor\n",
        "        self.forecast_horizon = forecast_horizon\n",
        "        self.device = device\n",
        "        self.node_map = {name: i for i, name in enumerate(sorted(node_features_tensors_dict.keys()))}\n",
        "        self.num_agents = len(self.node_map)\n",
        "\n",
        "        # Determine max feature dimension for padding\n",
        "        self.max_feat_dim = max(t.shape[1] for t in node_features_tensors_dict.values())\n",
        "\n",
        "        edge_list = [[i, j] for i in range(self.num_agents) for j in range(self.num_agents) if i != j]\n",
        "        self.edge_index = torch.tensor(edge_list, dtype=torch.long).t().contiguous().to(self.device)\n",
        "\n",
        "    def get_processed_data_tensor(self) -> TensorDict:\n",
        "        all_graph_data = []\n",
        "        node_names_sorted = sorted(self.node_map.keys())\n",
        "        for i in range(self.num_total_time_steps):\n",
        "            padded_features = []\n",
        "            for name in node_names_sorted:\n",
        "                feat = self.node_features_tensors_dict[name][i]\n",
        "                if feat.shape[0] < self.max_feat_dim:\n",
        "                    feat = torch.cat([feat, torch.zeros(self.max_feat_dim - feat.shape[0], device=self.device)], dim=0)\n",
        "                padded_features.append(feat)\n",
        "\n",
        "            x = torch.stack(padded_features)\n",
        "            graph_td = TensorDict({\n",
        "                \"agents\": TensorDict({\n",
        "                    \"data\": TensorDict({\n",
        "                        \"x\": x,\n",
        "                        \"edge_index\": self.edge_index,\n",
        "                        \"batch\": torch.zeros(self.num_agents, dtype=torch.int64, device=self.device),\n",
        "                        \"time\": torch.tensor([i], dtype=torch.int64, device=self.device),\n",
        "                        \"graph_attributes\": self.graph_attributes_tensor[i],\n",
        "                    }, device=self.device),\n",
        "                }, device=self.device)\n",
        "            }, device=self.device)\n",
        "            all_graph_data.append(graph_td)\n",
        "        return torch.stack(all_graph_data, dim=0)"
      ],
