        "import torch\n",
        "from tensordict import TensorDict, TensorDictBase\n",
        "from torchrl.envs import EnvBase\n",
        "from typing import Optional\n",
        "from torchrl.data import Composite, Unbounded, MultiCategorical\n",
        "\n",
        "# Ensure device is defined (assuming it's already set up or set to cpu if not)\n",
        "if 'device' not in globals():\n",
        "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "\n",
        "# Ensure data_path is defined from a previous cell\n",
        "if 'data_path' not in globals():\n",
        "    print(\"WARNING: 'data_path' not found. Please ensure it's defined in an earlier cell.\")\n",
        "    # Fallback for demonstration, but should be handled by user or earlier cell\n",
        "    data_path = \"/tmp/dummy_data\"\n",
        "\n",
        "# Define forecast_horizon\n",
        "forecast_horizon = 5 # Default value, adjust as needed\n",
        "\n",
        "# Instantiate actual DataPreprocessor\n",
        "# DataPreprocessor class is defined in cell 8MKITVAyV6mT\n",
        "data_preprocessor = DataPreprocessor(data_path, device)\n",
        "print(\"DataPreprocessor instantiated.\")\n",
        "\n",
        "# Instantiate actual FuelpriceenvfeatureGraph\n",
        "# FuelpriceenvfeatureGraph class is defined in cell 2VZT4wKrV8gD\n",
        "fuel_graph = FuelpriceenvfeatureGraph(\n",
        "    node_features_tensors_dict=data_preprocessor.node_features_tensors,\n",
        "    graph_attributes_tensor=data_preprocessor.graph_attributes_tensor,\n",
        "    forecast_horizon=forecast_horizon, # forecast_horizon is in global scope\n",
        "    device=device\n",
        ")\n",
        "print(\"FuelpriceenvfeatureGraph instantiated.\")\n",
        "\n",
        "data_tensor_processed = fuel_graph.get_processed_data_tensor()\n",
        "\n",
        "# Define parameters for AnFuelpriceEnv\n",
        "num_envs = 1\n",
        "seed = 42\n",
        "episode_length = 10\n",
        "num_agents = fuel_graph.num_agents # Use num_agents from actual fuel_graph\n",
        "num_individual_actions_features = 2 # Example value\n",
        "num_action_categories = 5 # Example value\n",
        "hidden_rnn_dim = 64 # Example value\n",
        "num_rnn_layers = 1 # Example value\n",
        "# forecast_horizon already defined globally\n",
        "\n",
        "# Define reward function weights for easy adjustment\n",
        "w1 = 1.0 # Weight for profit_term\n",
        "w2 = 0.1 # Weight for volatility_term\n",
        "w3 = 0.1 # Weight for forecast_term\n",
        "w4 = 0.1 # Weight for graph_term\n",
        "\n",
        "# Instantiate AnFuelpriceEnv to get observation_spec and action_spec\n",
        "env = AnFuelpriceEnv(\n",
        "    data_tensor=data_tensor_processed,\n",
        "    num_envs=num_envs,\n",
        "    seed=seed,\n",
        "    device=device,\n",
        "    episode_length=episode_length,\n",
        "    num_agents=num_agents,\n",
        "    num_individual_actions_features=num_individual_actions_features,\n",
        "    num_action_categories=num_action_categories,\n",
        "    hidden_rnn_dim=hidden_rnn_dim,\n",
        "    num_rnn_layers=num_rnn_layers,\n",
        "    forecast_horizon=forecast_horizon,\n",
        "    w1=100,\n",
        "    w2=100,\n",
        "    w3=100,\n",
        "    w4=100\n",
        ")\n",
        "observation_spec = env.observation_spec\n",
        "action_spec = env.action_spec\n",
        "\n",
        "# Define EnvDynamicsModel and instantiate it\n",
        "class EnvDynamicsModel(GraphProcessingBase):\n",
        "    def __init__(self, observation_spec, action_spec, hidden_rnn_dim, gcn_hidden_dim, num_agents, input_x_dim, device, num_gcn_layers, num_rnn_layers):\n",
        "        graph_attr_dim = observation_spec[\"agents\", \"data\", \"graph_attributes\"].shape[-1]\n",
        "        super().__init__(input_x_dim, gcn_hidden_dim, hidden_rnn_dim, num_agents, graph_attr_dim, device, num_gcn_layers, num_rnn_layers)\n",
        "        # Predicts the next state (x) for all agents\n",
        "        self.dynamics_head = nn.Linear(hidden_rnn_dim, num_agents * input_x_dim)\n",
        "\n",
        "    def forward(self, x, edge_index, batch_nodes, time, graph_attributes, hidden_state_env_in=None):\n",
        "        gru_output, h_out = self._process_graph_and_rnn(x, edge_index, time, graph_attributes, hidden_state_env_in)\n",
        "        next_x_pred = self.dynamics_head(gru_output).view(x.shape[0], -1, self.num_agents, self.input_x_dim)\n",
        "        return next_x_pred, h_out\n",
        "\n",
        "# Define gcn_hidden_dim and num_gcn_layers globally (already done in a prior turn based on notebook context)\n",
        "# hidden_rnn_dim, num_rnn_layers, input_x_dim, num_agents are also defined\n",
        "# These should be taken from the actual fuel_graph or env.\n",
        "gcn_hidden_dim = 64\n",
        "num_gcn_layers = 2\n",
        "hidden_rnn_dim = 64 # This should be derived from the env setup or model config\n",
        "num_rnn_layers = 1 # This should be derived from the env setup or model config\n",
        "input_x_dim = fuel_graph.max_feat_dim # Use max_feat_dim from actual fuel_graph\n",
        "num_agents = fuel_graph.num_agents # Use num_agents from actual fuel_graph\n",
        "\n",
        "env_model = EnvDynamicsModel(\n",
        "    observation_spec=observation_spec,\n",
        "    action_spec=action_spec,\n",
        "    hidden_rnn_dim=hidden_rnn_dim,\n",
        "    gcn_hidden_dim=gcn_hidden_dim,\n",
        "    num_agents=num_agents,\n",
        "    input_x_dim=input_x_dim,\n",
        "    device=device,\n",
        "    num_gcn_layers=num_gcn_layers,\n",
        "    num_rnn_layers=num_rnn_layers\n",
        ").to(device)\n",
        "\n",
        "print(\"EnvDynamicsModel defined and instantiated.\")\n"
      ],
