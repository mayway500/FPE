    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import multiprocessing as mp\n",
        "from tensordict import TensorDict\n",
        "from tensordict.nn import TensorDictModule\n",
        "from torchrl.modules import ProbabilisticActor, OneHotCategorical\n",
        "import os\n",
        "import time\n",
        "import wandb\n",
        "import torch.optim as optim\n",
        "from torchrl.objectives import ClipPPOLoss\n",
        "from torchrl.objectives.value import MultiAgentGAE\n",
        "from torchrl.modules import ValueOperator\n",
        "from torchrl.collectors import MultiCollector\n",
        "\n",
        "try:\n",
        "    mp.set_start_method(\"spawn\", force=True)\n",
        "except RuntimeError:\n",
        "    pass\n",
        "\n",
        "def train_multi_agent_parallel(cfg, device, node_features, graph_attrs):\n",
        "    shared_policy = worker_env_isolated.make_policy().to(device)\n",
        "    shared_policy.share_memory()\n",
        "\n",
        "    collector = MultiCollector(\n",
        "        create_env_fn=[worker_env_isolated.env_factory] * cfg['num_workers'],\n",
        "        policy=shared_policy,\n",
        "        frames_per_batch=cfg['frames_per_batch'],\n",
        "        total_frames=cfg['total_frames'],\n",
        "        device=device,\n",
        "        storing_device=device,\n",
        "        sync=True,\n",
        "        auto_register_policy_transforms=True\n",
        "    )\n",
        "\n",
        "    local_env = worker_env_isolated.env_factory()\n",
        "    critic_net = ValueBase(\n",
        "        local_env.observation_spec, cfg['hidden_dim'], cfg['gcn_hidden_dim'],\n",
        "        num_agents=local_env.num_agents, input_x_dim=local_env.observation_spec[\"agents\", \"data\", \"x\"].shape[-1], device=device,\n",
        "        num_gcn_layers=cfg['num_gcn_layers'], num_rnn_layers=cfg['num_rnn_layers']\n",
        "    ).to(device)\n",
        "\n",
        "    critic = ValueOperator(\n",
        "        module=critic_net,\n",
        "        in_keys=[(\"agents\", \"data\", \"x\"), (\"agents\", \"data\", \"edge_index\"), (\"agents\", \"data\", \"batch\"), (\"agents\", \"data\", \"time\"), (\"agents\", \"data\", \"graph_attributes\"), \"hidden_state_value\"],\n",
        "        out_keys=[\"state_value\", \"hidden_state_value\"]\n",
        "    )\n",
        "\n",
        "    loss_module = ClipPPOLoss(\n",
        "        actor=shared_policy,\n",
        "        critic=critic,\n",
        "        clip_epsilon=cfg['clip_epsilon'],\n",
        "        entropy_coeff=cfg['entropy_coeff'],\n",
        "        critic_coeff=cfg['critic_coeff']\n",
        "    )\n",
        "    loss_module.set_keys(reward=\"reward\", sample_log_prob=\"sample_log_prob\")\n",
        "\n",
        "    adv_module = MultiAgentGAE(gamma=0.99, lmbda=0.95, value_network=critic, average_gae=True)\n",
        "    adv_module.set_keys(reward=\"reward\")\n",
        "\n",
        "    optimizer = optim.Adam(loss_module.parameters(), lr=cfg['lr'])\n",
        "\n",
        "    print(f\"Starting Parallel Training with {cfg['num_workers']} workers...\")\n",
        "    total_collected_reward = 0.0\n",
        "    total_steps = 0\n",
        "\n",
        "    try:\n",
        "        for i, batch in enumerate(collector):\n",
        "            # 1. Handle Reward Mapping\n",
        "            if (\"next\", \"reward\") in batch.keys(include_nested=True):\n",
        "                batch.set(\"reward\", batch.get((\"next\", \"reward\")))\n",
        "\n",
        "            # 2. Fix log_prob KeyError: Map from nested agents key to root\n",
        "            if \"sample_log_prob\" not in batch.keys():\n",
        "                if (\"agents\", \"sample_log_prob\") in batch.keys(include_nested=True):\n",
        "                    batch.set(\"sample_log_prob\", batch.get((\"agents\", \"sample_log_prob\")))\n",
        "                elif (\"agents\", \"action_log_prob\") in batch.keys(include_nested=True):\n",
        "                    batch.set(\"sample_log_prob\", batch.get((\"agents\", \"action_log_prob\")))\n",
        "                elif \"sample_log_prob\" in batch.get(\"agents\").keys():\n",
        "                    batch.set(\"sample_log_prob\", batch[\"agents\", \"sample_log_prob\"])\n",
        "\n",
        "            # 3. Extract metrics for logging\n",
        "            metrics_to_log = {}\n",
        "            for k in ['profit_term_mean', 'volatility_term_mean', 'forecast_term_mean', 'graph_term_global_mean']:\n",
        "                if (\"next\", k) in batch.keys(include_nested=True):\n",
        "                    metrics_to_log[f\"env/{k}\"] = batch[\"next\", k].mean().item()\n",
        "\n",
        "            with torch.no_grad():\n",
        "                batch = adv_module(batch)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            loss_vals = loss_module(batch.reshape(-1))\n",
        "\n",
        "            # Calculate and add forecast loss\n",
        "            forecast_loss = torch.tensor(0.0, device=device) # Initialize\n",
        "            if \"forecast\" in batch.keys() and (\"next\", \"agents\", \"data\", \"x\") in batch.keys(include_nested=True):\n",
        "                agent_forecast = batch.get(\"forecast\") # Shape: [Batch, forecast_horizon, num_agents] from worker_env_isolated\n",
        "                target_x = batch.get((\"next\", \"agents\", \"data\", \"x\"))[..., 0] # Shape: [Batch, num_agents]\n",
        "\n",
        "                # Take the first step of the forecast for comparison with the immediate next state\n",
        "                predicted_price_current_step = agent_forecast[:, 0, :] # Shape: [Batch, num_agents]\n",
        "\n",
        "                if predicted_price_current_step.shape == target_x.shape:\n",
        "                    forecast_loss_fn = torch.nn.MSELoss()\n",
        "                    forecast_loss = forecast_loss_fn(predicted_price_current_step, target_x)\n",
        "                else:\n",
        "                    print(f\"Warning: Forecast and target shapes mismatch. Forecast: {predicted_price_current_step.shape}, Target: {target_x.shape}\")\n",
        "\n",
        "            total_loss = loss_vals[\"loss_objective\"] + loss_vals[\"loss_critic\"] + loss_vals[\"loss_entropy\"] + forecast_loss\n",
        "\n",
        "            total_loss.backward()\n",
        "            torch.nn.utils.clip_grad_norm_(loss_module.parameters(), cfg['max_grad_norm'])\n",
        "            optimizer.step()\n",
        "\n",
        "            step_reward = batch[\"next\", \"reward\"].mean().item()\n",
        "            total_collected_reward += step_reward\n",
        "            total_steps += 1\n",
        "\n",
        "            if i % 2 == 0:\n",
        "                log_dict = {\n",
        "                    \"train/total_loss\": total_loss.item(),\n",
        "                    \"train/ppo_actor_loss\": loss_vals[\"loss_objective\"].item(),\n",
        "                    \"train/ppo_critic_loss\": loss_vals[\"loss_critic\"].item(),\n",
        "                    \"train/ppo_entropy_loss\": loss_vals[\"loss_entropy\"].item(),\n",
        "                    \"train/forecast_loss\": forecast_loss.item(),\n",
        "                    \"reward/global_mean\": step_reward,\n",
        "                    **metrics_to_log\n",
        "                }\n",
        "                wandb.log(log_dict, step=i * cfg['frames_per_batch'])\n",
        "                print(f\"Batch {i} | Total Loss: {total_loss.item():.4f} | PPO Actor Loss: {loss_vals['loss_objective'].item():.4f} | Forecast Loss: {forecast_loss.item():.4f} | Reward: {step_reward:.4f}\")\n",
        "    finally:\n",
        "        collector.shutdown()\n",
        "\n",
        "    return total_collected_reward / total_steps if total_steps > 0 else 0.0"
      ],
