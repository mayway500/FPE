      "cell_type": "code",
      "source": [
        "# Install PyTorch 2.8.0 with CUDA 12.6\n",
        "!pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cu126\n",
        "\n",
        "# Install compatible torchvision and torchaudio\n",
        "!pip install torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu126\n",
        "!pip install torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cu126\n",
        "\n",
        "# Uninstall torchrl and tensordict to ensure clean install and reinstall\n",
        "!pip uninstall -y torchrl tensordict\n",
        "\n",
        "# Install torchrl and tensordict (will get compatible versions)\n",
        "!pip install torchrl tensordict\n",
        "\n",
        "# Verify tensordict and torchrl installation\n",
        "!pip show tensordict torchrl\n",
        "\n",
        "# Install Optuna and its Weights & Biases integration\n",
        "!pip install optuna\n",
        "!pip install optuna-integration[wandb]\n",
        "\n",
        "\n",
        "# Install Weights & Biases Weave for evaluation logging\n",
        "!pip install weave\n",
        "\n",
        "\n",
        "# Install core data science libraries (often pre-installed, but good to ensure)\n",
        "!pip install numpy pandas scipy networkx\n",
        "\n",
        "# Install other packages, now compatible with PyTorch 2.8.0\n",
        "!pip install tqdm\n",
        "!pip install torch_geometric\n",
        "!pip install pyg_lib torch_scatter torch_sparse -f https://data.pyg.org/whl/torch-2.8.0+cu126.html\n",
        "!pip install torch-summary"
      ],
