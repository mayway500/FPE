      "cell_type": "code",
      "source": [
        "class PolicyBase(GraphProcessingBase):\n",
        "    def __init__(self, observation_spec, action_spec, hidden_rnn_dim, gcn_hidden_dim, num_agents, input_x_dim, num_action_categories, num_individual_actions_features, device, num_gcn_layers, num_rnn_layers):\n",
        "        graph_attr_dim = observation_spec[\"agents\", \"data\", \"graph_attributes\"].shape[-1]\n",
        "        super().__init__(input_x_dim, gcn_hidden_dim, hidden_rnn_dim, num_agents, graph_attr_dim, device, num_gcn_layers, num_rnn_layers)\n",
        "        self.num_action_categories = num_action_categories\n",
        "        self.num_individual_actions_features = num_individual_actions_features\n",
        "        self.action_head = nn.Linear(hidden_rnn_dim, num_agents * num_individual_actions_features * num_action_categories)\n",
        "\n",
        "    def forward(self, x, edge_index, batch_nodes, time, graph_attributes, hidden_state=None):\n",
        "        gru_output, h_out = self._process_graph_and_rnn(x, edge_index, time, graph_attributes, hidden_state)\n",
        "        logits = self.action_head(gru_output)\n",
        "        return logits, h_out\n",
        "\n",
        "class ForecastingBase(nn.Module):\n",
        "    def __init__(self, observation_spec, forecast_horizon, gcn_hidden_dim, num_agents, input_x_dim, hidden_rnn_dim, device, num_gcn_layers, num_rnn_layers):\n",
        "        super().__init__()\n",
        "        graph_attr_dim = observation_spec[\"agents\", \"data\", \"graph_attributes\"].shape[-1]\n",
        "        self.backbone = GraphProcessingBase(input_x_dim, gcn_hidden_dim, hidden_rnn_dim, num_agents, graph_attr_dim, device, num_gcn_layers, num_rnn_layers)\n",
        "        self.num_agents = num_agents\n",
        "        self.forecast_horizon = forecast_horizon\n",
        "        self.forecast_head = nn.Linear(hidden_rnn_dim, num_agents * forecast_horizon)\n",
        "\n",
        "    def forward(self, x, edge_index, batch, time, graph_attr, hidden_state=None):\n",
        "        gru_output, h_out = self.backbone._process_graph_and_rnn(x, edge_index, time, graph_attr, hidden_state)\n",
        "        forecast = self.forecast_head(gru_output).view(*gru_output.shape[:-1], self.num_agents, self.forecast_horizon)\n",
        "        # Fix: Return actual gru_output instead of dummy tensor\n",
        "        return gru_output, forecast, h_out\n",
        "\n",
        "class ValueBase(GraphProcessingBase):\n",
        "    def __init__(self, observation_spec, hidden_rnn_dim, gcn_hidden_dim, num_agents, input_x_dim, device, num_gcn_layers, num_rnn_layers):\n",
        "        graph_attr_dim = observation_spec[\"agents\", \"data\", \"graph_attributes\"].shape[-1]\n",
        "        super().__init__(input_x_dim, gcn_hidden_dim, hidden_rnn_dim, num_agents, graph_attr_dim, device, num_gcn_layers, num_rnn_layers)\n",
        "        self.value_head = nn.Linear(hidden_rnn_dim, 1)\n",
        "\n",
        "    def forward(self, x, edge_index, batch_nodes, time, graph_attributes, hidden_state_value=None):\n",
        "        gru_output, h_out = self._process_graph_and_rnn(x, edge_index, time, graph_attributes, hidden_state_value)\n",
        "\n",
        "        # Unconditionally apply nan_to_num and clamp to prevent vmap issues\n",
        "        gru_output = torch.nan_to_num(gru_output, nan=0.0, posinf=1e5, neginf=-1e5)\n",
        "        gru_output = torch.clamp(gru_output, -1e4, 1e4)\n",
        "\n",
        "        value = self.value_head(gru_output)\n",
        "\n",
        "        # Unconditionally apply nan_to_num and clamp to prevent vmap issues\n",
        "        value = torch.nan_to_num(value, nan=0.0, posinf=1e5, neginf=-1e5)\n",
        "        value = torch.clamp(value, -1e4, 1e4)\n",
        "\n",
        "        return value, h_out"
      ],
