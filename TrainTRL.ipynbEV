    {
      "cell_type": "code",
      "source": [
        "def adjust_weights_dynamically(env_instance, current_step_metrics, total_steps_completed, adjustment_interval=50, weight_lr=0.01):\n",
        "    # Only adjust weights after a certain number of steps to allow for stable estimation\n",
        "    if total_steps_completed % adjustment_interval != 0 or total_steps_completed == 0:\n",
        "        return\n",
        "\n",
        "    # Get current weights\n",
        "    w1, w2, w3, w4 = env_instance.w1, env_instance.w2, env_instance.w3, env_instance.w4\n",
        "\n",
        "    # These metrics are typically negative for penalties and positive for rewards\n",
        "    profit_avg = current_step_metrics['profit_term_mean']\n",
        "    volatility_avg = current_step_metrics['volatility_term_mean']\n",
        "    forecast_avg = current_step_metrics['forecast_term_mean']\n",
        "    graph_avg = current_step_metrics['graph_term_global_mean']\n",
        "\n",
        "    # Simple heuristic: Increase weight for components that need more attention\n",
        "    # Profit: If average profit is low or negative, increase w1 to encourage more profit.\n",
        "    if profit_avg < 0.1: # Threshold to consider profit 'low'\n",
        "        w1 = w1 * (1 + weight_lr)\n",
        "    elif profit_avg > 0.5: # If profit is very high, slightly decrease to allow other objectives attention\n",
        "        w1 = w1 * (1 - weight_lr / 2)\n",
        "\n",
        "    # Volatility: If average volatility (penalty term) is high, increase w2 to reduce it.\n",
        "    if volatility_avg > 0.05: # Threshold to consider volatility 'high'\n",
        "        w2 = w2 * (1 + weight_lr)\n",
        "    elif volatility_avg < 0.01:\n",
        "        w2 = w2 * (1 - weight_lr / 2)\n",
        "\n",
        "    # Forecast Error: If average forecast error (penalty term) is high, increase w3 to improve forecast.\n",
        "    if forecast_avg > 0.05: # Threshold to consider forecast error 'high'\n",
        "        w3 = w3 * (1 + weight_lr)\n",
        "    elif forecast_avg < 0.01:\n",
        "        w3 = w3 * (1 - weight_lr / 2)\n",
        "\n",
        "    # Graph Divergence: If average graph divergence (penalty term) is high, increase w4 to promote coordination.\n",
        "    if graph_avg > 0.01: # Threshold to consider graph divergence 'high'\n",
        "        w4 = w4 * (1 + weight_lr)\n",
        "    elif graph_avg < 0.001:\n",
        "        w4 = w4 * (1 - weight_lr / 2)\n",
        "\n",
        "    # Ensure weights remain positive and apply some normalization (optional, but good practice)\n",
        "    # A simple normalization to sum=1 helps prevent weights from growing unbounded\n",
        "    total_weight = w1 + w2 + w3 + w4\n",
        "    w1, w2, w3, w4 = w1/total_weight, w2/total_weight, w3/total_weight, w4/total_weight\n",
        "\n",
        "    # Apply new weights to the environment\n",
        "    env_instance.set_weights(w1, w2, w3, w4)\n",
        "    print(f\"[Dynamic Weights] Step {total_steps_completed}: New weights: w1={w1:.4f}, w2={w2:.4f}, w3={w3:.4f}, w4={w4:.4f}\")\n",
        "    wandb.log({\"w1\": w1, \"w2\": w2, \"w3\": w3, \"w4\": w4}, step=total_steps_completed)\n",
        "\n",
        "def train_agent_optimized(trial, lr, hidden_rnn_dim, gcn_hidden_dim, num_gcn_layers, num_rnn_layers, clip_epsilon, entropy_coeff, critic_coeff, minibatch_size, num_epochs, seed, node_features_tensors_dict, graph_attributes_tensor, device, num_envs, num_individual_actions_features, num_action_categories, forecast_horizon, frames_per_batch, total_frames, max_grad_norm, gamma, lmbda, episode_length, allow_repeat_data, data_path, checkpoint_dir, project_name, log_interval, force_data_reload, max_dataset_size):\n",
        "    from torchrl.envs import TransformedEnv\n",
        "    from torchrl.envs.transforms import InitTracker, TensorDictPrimer\n",
        "    from torchrl.objectives import ClipPPOLoss\n",
        "    from torchrl.objectives.value import MultiAgentGAE\n",
        "    # Updated import for torchrl 0.13.3 compatibility\n",
        "    try:\n",
        "        from torchrl.collectors import SyncDataCollector\n",
        "    except ImportError:\n",
        "        from torchrl.collectors import Collector as SyncDataCollector\n",
        "\n",
        "    from torchrl.data import Unbounded\n",
        "    import torch.optim as optim\n",
        "\n",
        "    fuel_env_graph = FuelpriceenvfeatureGraph(\n",
        "        node_features_tensors_dict=node_features_tensors_dict,\n",
        "        graph_attributes_tensor=graph_attributes_tensor,\n",
        "        forecast_horizon=forecast_horizon,\n",
        "        device=device\n",
        "    )\n",
        "\n",
        "    # Initial weights for the environment\n",
        "    initial_w1, initial_w2, initial_w3, initial_w4 = 1.0, 0.1, 0.1, 0.1 # Example initial weights\n",
        "\n",
        "    base_env = AnFuelpriceEnv(\n",
        "        data_tensor=fuel_env_graph.get_processed_data_tensor(),\n",
        "        num_envs=num_envs,\n",
        "        seed=seed,\n",
        "        device=device,\n",
        "        episode_length=episode_length,\n",
        "        num_agents=fuel_env_graph.num_agents,\n",
        "        num_individual_actions_features=num_individual_actions_features,\n",
        "        num_action_categories=num_action_categories,\n",
        "        hidden_rnn_dim=hidden_rnn_dim,\n",
        "        num_rnn_layers=num_rnn_layers,\n",
        "        forecast_horizon=forecast_horizon,\n",
        "        batch_size=torch.Size([num_envs]),\n",
        "        w1=initial_w1, w2=initial_w2, w3=initial_w3, w4=initial_w4\n",
        "    )\n",
        "\n",
        "    env = TransformedEnv(base_env)\n",
        "    # Removed RewardSum transform as it was filtering necessary keys\n",
        "    # env.append_transform(RewardSum(in_keys=[\"reward\"], out_keys=[\"episode_reward\"])) # This accumulates the global reward\n",
        "\n",
        "    action_dim = fuel_env_graph.num_agents * num_individual_actions_features\n",
        "    env.append_transform(TensorDictPrimer(\n",
        "        {\n",
        "            \"hidden_state\": Unbounded(shape=(1, num_rnn_layers, hidden_rnn_dim)),\n",
        "            \"hidden_state_value\": Unbounded(shape=(1, num_rnn_layers, hidden_rnn_dim)),\n",
        "            (\"agents\", \"logits\"): Unbounded(shape=(action_dim * num_action_categories))\n",
        "        },\n",
        "        default_value=0,\n",
        "        expand_specs=True\n",
        "    ))\n",
        "    env.append_transform(InitTracker())\n",
        "\n",
        "    actual_num_agents = fuel_env_graph.num_agents\n",
        "    input_x_feature_dim_env = fuel_env_graph.max_feat_dim\n",
        "\n",
        "    actor_forecaster, critic = build_models_optimized(\n",
        "        env.observation_spec, env.action_spec, hidden_rnn_dim, gcn_hidden_dim,\n",
        "        actual_num_agents, input_x_feature_dim_env, num_action_categories,\n",
        "        num_individual_actions_features, forecast_horizon, device, num_gcn_layers, num_rnn_layers\n",
        "    )\n",
        "\n",
        "    loss_module = ClipPPOLoss(\n",
        "        actor=actor_forecaster,\n",
        "        critic=critic,\n",
        "        clip_epsilon=clip_epsilon,\n",
        "        entropy_coeff=entropy_coeff,\n",
        "        critic_coeff=critic_coeff\n",
        "    )\n",
        "    loss_module.set_keys(reward=\"reward\", sample_log_prob=\"sample_log_prob\")\n",
        "\n",
        "    adv_module = MultiAgentGAE(\n",
        "        gamma=gamma,\n",
        "        lmbda=lmbda,\n",
        "        value_network=critic,\n",
        "        average_gae=True\n",
        "    )\n",
        "    adv_module.set_keys(reward=\"reward\")\n",
        "\n",
        "    optimizer_actor_critic = optim.Adam(loss_module.parameters(), lr=lr)\n",
        "\n",
        "    underlying_model = actor_forecaster[0].module\n",
        "    optimizer_forecaster = optim.Adam(underlying_model.forecast_head.parameters(), lr=lr)\n",
        "\n",
        "    collector = SyncDataCollector(\n",
        "        env,\n",
        "        actor_forecaster,\n",
        "        frames_per_batch=frames_per_batch,\n",
        "        total_frames=total_frames,\n",
        "        device=device,\n",
        "        storing_device=device\n",
        "    )\n",
        "\n",
        "    globals()['collector'] = collector\n",
        "\n",
        "    total_reward = 0\n",
        "    num_batches = 0\n",
        "    current_episode_reward = 0.0 # Manually track episode reward\n",
        "\n",
        "    try:\n",
        "        for i, tensordict_data in enumerate(collector):\n",
        "            # print(f\"[Collector Debug] Iteration {i}: tensordict_data keys (include_nested=True): {tensordict_data.keys(include_nested=True)}\")\n",
        "            # print(f\"[Collector Debug] Iteration {i}: tensordict_data['next'] keys: {tensordict_data.get('next').keys()}\")\n",
        "\n",
        "            # Extract individual reward components for dynamic weighting\n",
        "            current_step_metrics = {\n",
        "                'profit_term_mean': tensordict_data[\"next\", \"profit_term_mean\"].mean().item(),\n",
        "                'volatility_term_mean': tensordict_data[\"next\", \"volatility_term_mean\"].mean().item(),\n",
        "                'forecast_term_mean': tensordict_data[\"next\", \"forecast_term_mean\"].mean().item(),\n",
        "                'graph_term_global_mean': tensordict_data[\"next\", \"graph_term_global_mean\"].mean().item()\n",
        "            }\n",
        "\n",
        "            # Dynamically adjust weights\n",
        "            adjust_weights_dynamically(base_env, current_step_metrics, i, adjustment_interval=10, weight_lr=0.005)\n",
        "\n",
        "            f_loss = train_forecaster_step(tensordict_data, underlying_model, optimizer_forecaster, actual_num_agents, input_x_feature_dim_env, i, wandb)\n",
        "            a_loss, c_loss, e_loss = train_ppo_step(tensordict_data, adv_module, loss_module, optimizer_actor_critic, num_epochs, minibatch_size, max_grad_norm, i, wandb)\n",
        "\n",
        "            step_reward = tensordict_data[\"next\", \"reward\"].mean().item() # Mean reward for the current step/batch\n",
        "            current_episode_reward += step_reward\n",
        "            total_reward += step_reward\n",
        "            num_batches += 1\n",
        "\n",
        "            if i % log_interval == 0:\n",
        "                print(f\"[Training Log] Step {i} | Mean Reward: {step_reward:.4f} | Actor Loss: {a_loss:.4f} | Critic Loss: {c_loss:.4f} | Entropy Loss: {e_loss:.4f} | Forecaster Loss: {f_loss:.4f}\")\n",
        "                wandb.log({\n",
        "                    \"mean_step_reward\": step_reward,\n",
        "                    \"actor_loss\": a_loss,\n",
        "                    \"critic_loss\": c_loss,\n",
        "                    \"entropy_loss\": e_loss,\n",
        "                    \"forecaster_loss\": f_loss,\n",
        "                    \"profit_term_mean\": current_step_metrics['profit_term_mean'],\n",
        "                    \"volatility_term_mean\": current_step_metrics['volatility_term_mean'],\n",
        "                    \"forecast_term_mean\": current_step_metrics['forecast_term_mean'],\n",
        "                    \"graph_term_global_mean\": current_step_metrics['graph_term_global_mean']\n",
        "                }, step=i)\n",
        "\n",
        "            # Check if episode is done and log episode reward\n",
        "            if tensordict_data[\"next\", \"done\"].any(): # Assuming 'done' is [batch_size, 1]\n",
        "                wandb.log({\"episode_reward\": current_episode_reward}, step=i)\n",
        "                current_episode_reward = 0.0\n",
        "\n",
        "    finally:\n",
        "        collector.shutdown()\n",
        "\n",
        "    return {\"mean_reward\": total_reward / num_batches if num_batches > 0 else 0.0}"
      ],
      "metadata": {
        "id": "kBTZcMjh0r8t"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def train_forecaster_step(tensordict_data, model, optimizer, num_agents, input_x_dim, step, wandb_run):\n",
        "    # Extract input features from the batch\n",
        "    # We need to re-run the forward pass on the collected batch to maintain the graph\n",
        "    x = tensordict_data[\"agents\", \"data\", \"x\"]\n",
        "    edge_index = tensordict_data[\"agents\", \"data\", \"edge_index\"]\n",
        "    batch_nodes = tensordict_data[\"agents\", \"data\", \"batch\"]\n",
        "    time = tensordict_data[\"agents\", \"data\", \"time\"]\n",
        "    graph_attributes = tensordict_data[\"agents\", \"data\", \"graph_attributes\"]\n",
        "    hidden_state_in = tensordict_data[\"hidden_state\"]\n",
        "\n",
        "    # Re-run model with gradients enabled\n",
        "    logits, forecast, _ = model(\n",
        "        x=x,\n",
        "        edge_index=edge_index,\n",
        "        batch_nodes=batch_nodes,\n",
        "        time=time,\n",
        "        graph_attributes=graph_attributes,\n",
        "        hidden_state_in=hidden_state_in\n",
        "    )\n",
        "\n",
        "    # forecast shape: [B, T, H, A]\n",
        "    # target_x shape: [B, T, A]\n",
        "    target_x = tensordict_data[\"next\", \"agents\", \"data\", \"x\"][..., 0]\n",
        "\n",
        "    # Price prediction is first step of horizon: [B, T, A]\n",
        "    predicted_price = forecast[..., 0, :]\n",
        "\n",
        "    if predicted_price.shape != target_x.shape:\n",
        "        predicted_price = predicted_price.reshape(target_x.shape)\n",
        "\n",
        "    loss_fn = torch.nn.MSELoss()\n",
        "    loss = loss_fn(predicted_price, target_x)\n",
        "\n",
        "    if loss.requires_grad:\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        return loss.item()\n",
        "    else:\n",
        "        return 0.0"
      ],
      "metadata": {
        "id": "fnzmIyC10zn9"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def train_ppo_step(tensordict_data, adv_module, loss_module, optimizer, num_epochs, minibatch_size, max_grad_norm, step, wandb_run):\n",
        "    import torch\n",
        "\n",
        "    # In TorchRL SyncDataCollector, rewards for the transition s_t -> s_{t+1} are stored in ['next', 'reward']\n",
        "    reward = tensordict_data.get((\"next\", \"reward\"), None)\n",
        "\n",
        "    if reward is not None:\n",
        "        # Numerical Stability Clamping\n",
        "        if torch.isnan(reward).any() or torch.isinf(reward).any():\n",
        "            reward = torch.nan_to_num(reward, nan=0.0, posinf=1e5, neginf=-1e5)\n",
        "        reward = torch.clamp(reward, -1e3, 1e3)\n",
        "\n",
        "        # Move to root so MultiAgentGAE and ClipPPOLoss can find it\n",
        "        tensordict_data.set(\"reward\", reward)\n",
        "\n",
        "    # Debugging inputs to critic_net\n",
        "    if step % 10 == 0:\n",
        "        print(f\"--- [PPO Training Step {step}] ---\")\n",
        "        with torch.no_grad():\n",
        "            current_reward = tensordict_data.get('reward')\n",
        "            print(f\"  Mean Reward: {current_reward.mean().item():.4f}\")\n",
        "\n",
        "    # MultiAgentGAE computes 'advantage' and 'value_targets'\n",
        "    with torch.no_grad():\n",
        "        tensordict_data = adv_module(tensordict_data)\n",
        "\n",
        "    data_view = tensordict_data.reshape(-1)\n",
        "    a_losses, c_losses, e_losses = [], [], []\n",
        "\n",
        "    for _ in range(num_epochs):\n",
        "        perm = torch.randperm(data_view.shape[0], device=data_view.device)\n",
        "        for indices in perm.split(minibatch_size):\n",
        "            sub_data = data_view[indices].clone()\n",
        "\n",
        "            # Map log-prob key if necessary (TorchRL sometimes nests this under 'agents')\n",
        "            if \"sample_log_prob\" not in sub_data.keys():\n",
        "                if (\"agents\", \"action_log_prob\") in sub_data.keys(include_nested=True):\n",
        "                    sub_data.set(\"sample_log_prob\", sub_data.get((\"agents\", \"action_log_prob\")))\n",
        "\n",
        "            # Stability check for log-probs\n",
        "            lp = sub_data.get(\"sample_log_prob\", torch.tensor(-1.0))\n",
        "            sub_data.set(\"sample_log_prob\", torch.nan_to_num(lp, nan=-20.0))\n",
        "\n",
        "            loss_vals = loss_module(sub_data)\n",
        "\n",
        "            # Combined loss with individual term clamping to prevent gradient explosion\n",
        "            loss_value = (loss_vals[\"loss_objective\"].clamp(-10, 10) +\n",
        "                          loss_vals[\"loss_critic\"].clamp(-10, 10) +\n",
        "                          loss_vals[\"loss_entropy\"].clamp(-10, 10))\n",
        "\n",
        "            if not torch.isnan(loss_value) and not torch.isinf(loss_value):\n",
        "                optimizer.zero_grad()\n",
        "                loss_value.backward()\n",
        "                torch.nn.utils.clip_grad_norm_(loss_module.parameters(), max_grad_norm)\n",
        "                optimizer.step()\n",
        "\n",
        "                a_losses.append(loss_vals[\"loss_objective\"].item())\n",
        "                c_losses.append(loss_vals[\"loss_critic\"].item())\n",
        "                e_losses.append(loss_vals[\"loss_entropy\"].item())\n",
        "\n",
        "    return (\n",
        "        sum(a_losses) / len(a_losses) if a_losses else 0.0,\n",
        "        sum(c_losses) / len(c_losses) if c_losses else 0.0,\n",
        "        sum(e_losses) / len(e_losses) if e_losses else 0.0\n",
        "    )"
      ],
