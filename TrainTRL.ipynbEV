      "cell_type": "code",
      "source": [
        "import torch\n",
        "from tensordict import TensorDict, TensorDictBase\n",
        "from torchrl.envs import EnvBase\n",
        "from typing import Optional\n",
        "from torchrl.data import Composite, Unbounded, MultiCategorical\n",
        "\n",
        "class AnFuelpriceEnv(EnvBase):\n",
        "    def __init__(self, data_tensor, num_envs, seed, device, episode_length, num_agents, num_individual_actions_features, num_action_categories, hidden_rnn_dim, num_rnn_layers, forecast_horizon, batch_size=None, w1=1.0, w2=0.1, w3=0.1, w4=0.1):\n",
        "        if batch_size is None:\n",
        "            batch_size = torch.Size([num_envs])\n",
        "        super().__init__(device=device, batch_size=batch_size)\n",
        "        self.data_tensor = data_tensor.to(device)\n",
        "        self.num_envs = num_envs\n",
        "        self.episode_length = episode_length\n",
        "        self.num_agents = num_agents\n",
        "        self.num_individual_actions_features = num_individual_actions_features\n",
        "        self.num_action_categories = num_action_categories\n",
        "        self.forecast_horizon = forecast_horizon\n",
        "        self.hidden_rnn_dim = hidden_rnn_dim\n",
        "        self.num_rnn_layers = num_rnn_layers\n",
        "        self.w1, self.w2, self.w3, self.w4 = w1, w2, w3, w4\n",
        "        self._make_spec()\n",
        "        if seed is not None:\n",
        "            self.set_seed(seed)\n",
        "        print(f\"AnFuelpriceEnv initialized with weights: w1={self.w1}, w2={self.w2}, w3={self.w3}, w4={self.w4}\")\n",
        "\n",
        "    def _make_spec(self):\n",
        "        data_spec = Composite(\n",
        "            x=Unbounded(shape=(*self.batch_size, self.num_agents, self.data_tensor.get((\"agents\", \"data\", \"x\")).shape[-1])),\n",
        "            edge_index=Unbounded(shape=(*self.batch_size, 2, self.data_tensor.get((\"agents\", \"data\", \"edge_index\")).shape[-1]), dtype=torch.long),\n",
        "            batch=Unbounded(shape=(*self.batch_size, self.num_agents,), dtype=torch.long),\n",
        "            time=Unbounded(shape=(*self.batch_size, 1,), dtype=torch.long),\n",
        "            graph_attributes=Unbounded(shape=(*self.batch_size, self.data_tensor.get((\"agents\", \"data\", \"graph_attributes\")).shape[-1],))\n",
        "        ).to(self.device)\n",
        "\n",
        "        self.observation_spec = Composite(\n",
        "            agents=Composite(data=data_spec, shape=self.batch_size, device=self.device),\n",
        "            hidden_state=Unbounded(shape=(*self.batch_size, 1, self.num_rnn_layers, self.hidden_rnn_dim)),\n",
        "            forecast=Unbounded(shape=(*self.batch_size, 1, self.forecast_horizon, self.num_agents)),\n",
        "            profit_term_mean=Unbounded(shape=(*self.batch_size, 1)), # Added for dynamic weighting\n",
        "            volatility_term_mean=Unbounded(shape=(*self.batch_size, 1)), # Added for dynamic weighting\n",
        "            forecast_term_mean=Unbounded(shape=(*self.batch_size, 1)), # Added for dynamic weighting\n",
        "            graph_term_global_mean=Unbounded(shape=(*self.batch_size, 1)), # Added for dynamic weighting\n",
        "            shape=self.batch_size,\n",
        "            device=self.device\n",
        "        )\n",
        "\n",
        "        action_dim = self.num_agents * self.num_individual_actions_features\n",
        "        self.action_spec = Composite(\n",
        "            agents=Composite(\n",
        "                action=MultiCategorical(nvec=[self.num_action_categories] * action_dim, shape=torch.Size([*self.batch_size, action_dim])),\n",
        "                logits=Unbounded(shape=(*self.batch_size, action_dim * self.num_action_categories)),\n",
        "                shape=self.batch_size,\n",
        "                device=self.device\n",
        "            ),\n",
        "            shape=self.batch_size,\n",
        "            device=self.device\n",
        "        )\n",
        "\n",
        "        # Standardizing reward spec to ensure visibility outside env.step()\n",
        "        # The overall reward is a single scalar. Individual terms are supplementary.\n",
        "        self.reward_spec = Unbounded(shape=(*self.batch_size, 1), device=self.device)\n",
        "\n",
        "        status_shape = torch.Size([*self.batch_size, 1])\n",
        "        self.done_spec = Composite(\n",
        "            done=Unbounded(shape=status_shape, dtype=torch.bool),\n",
        "            terminated=Unbounded(shape=status_shape, dtype=torch.bool),\n",
        "            truncated=Unbounded(shape=status_shape, dtype=torch.bool),\n",
        "            shape=self.batch_size,\n",
        "            device=self.device\n",
        "        )\n",
        "\n",
        "    def _reset(self, tensordict=None):\n",
        "        self.current_step = 0\n",
        "        max_start = self.data_tensor.shape[0] - self.episode_length - self.forecast_horizon - 10\n",
        "        initial_start_idx = torch.randint(0, max_start, (1,)).item()\n",
        "        self.start_idx = initial_start_idx\n",
        "        initial_obs_raw_data = self.data_tensor[self.start_idx].clone()\n",
        "        if self.batch_size:\n",
        "            initial_obs_raw_data = initial_obs_raw_data.expand(self.batch_size).to_tensordict()\n",
        "\n",
        "        initial_td = TensorDict(\n",
        "            {\n",
        "                (\"agents\", \"data\", \"x\"): initial_obs_raw_data.get((\"agents\", \"data\", \"x\")),\n",
        "                (\"agents\", \"data\", \"edge_index\"): initial_obs_raw_data.get((\"agents\", \"data\", \"edge_index\")),\n",
        "                (\"agents\", \"data\", \"batch\"): initial_obs_raw_data.get((\"agents\", \"data\", \"batch\")),\n",
        "                (\"agents\", \"data\", \"time\"): initial_obs_raw_data.get((\"agents\", \"data\", \"time\")),\n",
        "                (\"agents\", \"data\", \"graph_attributes\"): initial_obs_raw_data.get((\"agents\", \"data\", \"graph_attributes\")),\n",
        "                \"hidden_state\": torch.zeros(*self.batch_size, 1, self.num_rnn_layers, self.hidden_rnn_dim, device=self.device),\n",
        "                \"forecast\": torch.zeros(*self.batch_size, 1, self.forecast_horizon, self.num_agents, device=self.device),\n",
        "                # Initialize these to zero for the first observation, they will be updated in _step\n",
        "                \"profit_term_mean\": torch.zeros(*self.batch_size, 1, device=self.device),\n",
        "                \"volatility_term_mean\": torch.zeros(*self.batch_size, 1, device=self.device),\n",
        "                \"forecast_term_mean\": torch.zeros(*self.batch_size, 1, device=self.device),\n",
        "                \"graph_term_global_mean\": torch.zeros(*self.batch_size, 1, device=self.device)\n",
        "            }, batch_size=self.batch_size, device=self.device\n",
        "        )\n",
        "        return initial_td\n",
        "\n",
        "    def _step(self, tensordict: TensorDictBase) -> TensorDictBase:\n",
        "        curr_x = tensordict.get((\"agents\", \"data\", \"x\"))\n",
        "        model_forecast = tensordict.get(\"forecast\")\n",
        "        hidden_state_prev = tensordict.get(\"hidden_state\")\n",
        "\n",
        "        self.current_step += 1\n",
        "        new_idx = self.start_idx + self.current_step\n",
        "        next_obs = self.data_tensor[new_idx].expand(self.batch_size).to_tensordict()\n",
        "\n",
        "        # 1. Reward Calculation Logic\n",
        "        next_x = next_obs.get((\"agents\", \"data\", \"x\"))\n",
        "\n",
        "        profit_term = next_x[..., 0] - curr_x[..., 0]\n",
        "        profit_term = torch.nan_to_num(profit_term, nan=0.0, posinf=1e3, neginf=-1e3)\n",
        "        profit_term = torch.clamp(profit_term, -1e3, 1e3)\n",
        "\n",
        "        volatility_term = profit_term ** 2\n",
        "        volatility_term = torch.nan_to_num(volatility_term, nan=0.0, posinf=1e3, neginf=-1e3)\n",
        "        volatility_term = torch.clamp(volatility_term, 0.0, 1e3)\n",
        "\n",
        "        f_price = model_forecast.squeeze(1)[:, 0]\n",
        "        forecast_term = (f_price - next_x[..., 0]) ** 2\n",
        "        forecast_term = torch.nan_to_num(forecast_term, nan=0.0, posinf=1e3, neginf=-1e3)\n",
        "        forecast_term = torch.clamp(forecast_term, 0.0, 1e3)\n",
        "\n",
        "        edge_idx = next_obs.get((\"agents\", \"data\", \"edge_index\"))\n",
        "        s_p = profit_term.gather(1, edge_idx[:, 0, :])\n",
        "        t_p = profit_term.gather(1, edge_idx[:, 1, :])\n",
        "        graph_term_global = ((s_p - t_p) ** 2).mean(dim=-1, keepdim=True)\n",
        "        graph_term_global = torch.nan_to_num(graph_term_global, nan=0.0, posinf=1e3, neginf=-1e3)\n",
        "        graph_term_global = torch.clamp(graph_term_global, 0.0, 1e3)\n",
        "\n",
        "        # Calculate mean agent reward\n",
        "        multi_agent_reward = (self.w1 * profit_term - self.w2 * volatility_term - self.w3 * forecast_term - self.w4 * graph_term_global).unsqueeze(-1)\n",
        "        global_reward = multi_agent_reward.mean(dim=-2)\n",
        "        global_reward = torch.nan_to_num(global_reward, nan=0.0, posinf=1e4, neginf=-1e4)\n",
        "        global_reward = torch.clamp(global_reward, -1e4, 1e4)\n",
        "\n",
        "        # 2. Build explicit output\n",
        "        out = next_obs.clone()\n",
        "        out.set(\"reward\", global_reward)\n",
        "        done = torch.full((*self.batch_size, 1), self.current_step >= self.episode_length, dtype=torch.bool, device=self.device)\n",
        "        out.set(\"done\", done)\n",
        "        out.set(\"terminated\", done)\n",
        "        out.set(\"truncated\", torch.zeros((*self.batch_size, 1), dtype=torch.bool, device=self.device))\n",
        "        out.set(\"hidden_state\", hidden_state_prev.clone())\n",
        "        out.set(\"forecast\", model_forecast.clone())\n",
        "\n",
        "        # Store individual reward components for analysis and dynamic weighting\n",
        "        # Ensuring consistent shape [batch_size, 1] for logging/analysis\n",
        "        out.set(\"profit_term_mean\", profit_term.mean(dim=-1, keepdim=True))\n",
        "        out.set(\"volatility_term_mean\", volatility_term.mean(dim=-1, keepdim=True))\n",
        "        out.set(\"forecast_term_mean\", forecast_term.mean(dim=-1, keepdim=True))\n",
        "        out.set(\"graph_term_global_mean\", graph_term_global)\n",
        "\n",
        "        # Internal debug print to confirm keys are set\n",
        "        # print(f\"[Env Debug] Step {self.current_step} | Global Reward: {global_reward.mean().item():.4f} | Keys in out: {out.keys()}\")\n",
        "\n",
        "        return out\n",
        "\n",
        "    def _set_seed(self, seed):\n",
        "        if seed is not None: torch.manual_seed(seed)\n",
        "\n",
        "    def set_weights(self, w1, w2, w3, w4):\n",
        "        \"\"\"Dynamically updates the reward weights.\"\"\"\n",
        "        self.w1 = w1\n",
        "        self.w2 = w2\n",
        "        self.w3 = w3\n",
        "        self.w4 = w4\n"
      ],
      "metadata": {
        "id": "C-8yrmXUzlaB"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from torchrl.envs.transforms import Transform\n",
        "from torchrl.data import Unbounded, Composite\n",
        "import torch\n",
        "\n",
        "class SumMultiAgentReward(Transform):\n",
        "    def __init__(self, in_keys=None, out_keys=None, num_agents_env=1):\n",
        "        # By default, look for ('agents', 'reward') or just 'reward'\n",
        "        if in_keys is None: in_keys = [(\"agents\", \"reward\")]\n",
        "        if out_keys is None: out_keys = [\"reward\"]\n",
        "        super().__init__(in_keys=in_keys, out_keys=out_keys)\n",
        "        self.num_agents_env = num_agents_env\n",
        "\n",
        "    def _apply_transform(self, reward):\n",
        "        # If reward has an agent dimension (size > 1 at dim -2), sum it\n",
        "        if reward.ndim >= 2 and reward.shape[-2] > 1:\n",
        "            return reward.sum(dim=-2)\n",
        "        return reward\n",
        "\n",
        "    def transform_reward_spec(self, reward_spec):\n",
        "        # Ensure we return a spec with a concrete torch.Size [..., 1]\n",
        "        new_shape = torch.Size([*reward_spec.shape[:-2], 1]) if reward_spec.shape.numel() >= 2 else torch.Size([1, 1])\n",
        "        return Unbounded(shape=new_shape, device=reward_spec.device, dtype=reward_spec.dtype)\n",
        "\n",
        "    def transform_output_spec(self, output_spec):\n",
        "        if \"full_reward_spec\" in output_spec.keys():\n",
        "            curr_spec = output_spec[\"full_reward_spec\"]\n",
        "            in_key = self.in_keys[0]\n",
        "            out_key = self.out_keys[0]\n",
        "\n",
        "            # If Composite, we check if the in_key exists before indexing\n",
        "            if isinstance(curr_spec, Composite):\n",
        "                # Use the existing spec of the in_key to derive the out_key spec\n",
        "                # If in_key is missing (e.g. env already flat), we use the root spec\n",
        "                try:\n",
        "                    base_spec = curr_spec[in_key]\n",
        "                except (KeyError, AttributeError):\n",
        "                    base_spec = curr_spec\n",
        "\n",
        "                curr_spec[out_key] = self.transform_reward_spec(base_spec)\n",
        "            else:\n",
        "                # If the spec is already flat, just update the main reward spec\n",
        "                output_spec[\"full_reward_spec\"] = self.transform_reward_spec(curr_spec)\n",
        "        return output_spec"
      ],
      "metadata": {
        "id": "fnxvfGOQzomB"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch_geometric.nn import GATConv, global_mean_pool\n",
        "\n",
        "class GraphProcessingBase(nn.Module):\n",
        "    def __init__(self, input_x_dim, gcn_hidden_dim, hidden_rnn_dim, num_agents, graph_attr_dim, device, num_gcn_layers, num_rnn_layers):\n",
        "        super().__init__()\n",
        "        self.device = device\n",
        "        self.num_agents = num_agents\n",
        "        self.hidden_rnn_dim = hidden_rnn_dim\n",
        "        self.num_rnn_layers = num_rnn_layers\n",
        "        self.input_x_dim = input_x_dim\n",
        "\n",
        "        self.gcn_layers = nn.ModuleList()\n",
        "        self.gcn_layers.append(GATConv(input_x_dim + graph_attr_dim, gcn_hidden_dim, add_self_loops=False))\n",
        "        for _ in range(num_gcn_layers - 1):\n",
        "            self.gcn_layers.append(GATConv(gcn_hidden_dim, gcn_hidden_dim, add_self_loops=False))\n",
        "\n",
        "        self.gru = nn.GRU(gcn_hidden_dim, hidden_rnn_dim, num_rnn_layers, batch_first=True)\n",
        "        self._apply_init()\n",
        "\n",
        "    def _apply_init(self):\n",
        "        for m in self.modules():\n",
        "            if isinstance(m, (nn.Linear, GATConv)):\n",
        "                target = m.lin.weight if hasattr(m, 'lin') else m.weight\n",
        "                nn.init.xavier_uniform_(target)\n",
        "                if hasattr(m, 'bias') and m.bias is not None:\n",
        "                    nn.init.constant_(m.bias, 0)\n",
        "            elif isinstance(m, nn.GRU):\n",
        "                for name, param in m.named_parameters():\n",
        "                    if 'weight' in name:\n",
        "                        nn.init.orthogonal_(param)\n",
        "                    elif 'bias' in name:\n",
        "                        nn.init.constant_(param, 0)\n",
        "\n",
        "    def _process_graph_and_rnn(self, x, edge_index, time, graph_attr, hidden_state=None):\n",
        "        x = torch.clamp(x, -5.0, 5.0)\n",
        "        graph_attr = torch.clamp(graph_attr, -5.0, 5.0)\n",
        "\n",
        "        expanded_attr = graph_attr.unsqueeze(-2).expand(*x.shape[:-1], graph_attr.shape[-1])\n",
        "        x_in = torch.cat([x, expanded_attr], dim=-1)\n",
        "\n",
        "        orig_shape = x_in.shape\n",
        "        x_flat = x_in.reshape(-1, self.num_agents, x_in.shape[-1])\n",
        "        total_graphs = x_flat.shape[0]\n",
        "\n",
        "        x_gcn = x_flat.reshape(-1, x_in.shape[-1])\n",
        "        batch_ptr = torch.arange(total_graphs, device=self.device).repeat_interleave(self.num_agents)\n",
        "\n",
        "        e_idx = edge_index.view(-1, 2, edge_index.shape[-1])\n",
        "        e_idx = e_idx[0] if e_idx.dim() > 2 else edge_index.squeeze(0)\n",
        "        shift = torch.arange(total_graphs, device=self.device).view(-1, 1, 1) * self.num_agents\n",
        "        batched_e_idx = (e_idx.unsqueeze(0) + shift).transpose(1, 2).reshape(2, -1)\n",
        "\n",
        "        curr_feat = x_gcn\n",
        "        for layer in self.gcn_layers:\n",
        "            curr_feat = torch.relu(layer(curr_feat, batched_e_idx))\n",
        "\n",
        "        pooled = global_mean_pool(curr_feat, batch_ptr)\n",
        "        pooled = torch.nan_to_num(pooled, nan=0.0, posinf=1e4, neginf=-1e4)\n",
        "        pooled = torch.clamp(pooled, -1e4, 1e4)\n",
        "\n",
        "        gru_in = pooled.view(total_graphs, 1, -1)\n",
        "\n",
        "        if hidden_state is None:\n",
        "            h_t = torch.zeros(self.num_rnn_layers, total_graphs, self.hidden_rnn_dim, device=self.device)\n",
        "        else:\n",
        "            # Permute to [Layers, Batch, Hidden]\n",
        "            h_t = hidden_state.reshape(-1, self.num_rnn_layers, self.hidden_rnn_dim).permute(1, 0, 2).contiguous()\n",
        "            # Dynamic Batch Alignment: Repeat if batch dim doesn't match the current graph count\n",
        "            if h_t.shape[1] != total_graphs:\n",
        "                 h_t = h_t.repeat(1, total_graphs // h_t.shape[1], 1)\n",
        "\n",
        "        outputs = []\n",
        "        for t in range(gru_in.shape[1]):\n",
        "            xt = gru_in[:, t, :]\n",
        "            new_h = []\n",
        "            for l in range(self.num_rnn_layers):\n",
        "                w_ih, w_hh = getattr(self.gru, f'weight_ih_l{l}'), getattr(self.gru, f'weight_hh_l{l}')\n",
        "                b_ih, b_hh = getattr(self.gru, f'bias_ih_l{l}'), getattr(self.gru, f'bias_hh_l{l}')\n",
        "\n",
        "                gi = torch.nn.functional.linear(xt, w_ih, b_ih)\n",
        "                gh = torch.nn.functional.linear(h_t[l], w_hh, b_hh)\n",
        "                i_r, i_z, i_n = gi.chunk(3, 1)\n",
        "                h_r, h_z, h_n = gh.chunk(3, 1)\n",
        "\n",
        "                r, z = torch.sigmoid(i_r + h_r), torch.sigmoid(i_z + h_z)\n",
        "                n = torch.tanh(i_n + r * h_n)\n",
        "                ht_next = n + z * (h_t[l] - n)\n",
        "                new_h.append(ht_next)\n",
        "                xt = ht_next\n",
        "            h_t = torch.stack(new_h)\n",
        "            outputs.append(xt.unsqueeze(1))\n",
        "\n",
        "        gru_out = torch.cat(outputs, dim=1).view(*orig_shape[:-2], self.hidden_rnn_dim)\n",
        "        gru_out = torch.nan_to_num(gru_out, nan=0.0, posinf=1e4, neginf=-1e4)\n",
        "        gru_out = torch.clamp(gru_out, -1e4, 1e4)\n",
        "\n",
        "        h_final = h_t.permute(1, 0, 2).reshape(*orig_shape[:-2], 1, self.num_rnn_layers, self.hidden_rnn_dim)\n",
        "\n",
        "        return gru_out, h_final"
      ],
