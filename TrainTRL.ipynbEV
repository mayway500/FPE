        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.distributions as tdists\n",
        "from torch_geometric.nn import GATConv, global_mean_pool\n",
        "from typing import Optional, Tuple\n",
        "from torchrl.envs.transforms import Transform, RewardSum\n",
        "from torchrl.envs.utils import ExplorationType, set_exploration_type\n",
        "from torchrl.data import Unbounded\n",
        "\n",
        "class Custom_MultiCategorical(tdists.Distribution):\n",
        "    def __init__(self, logits: torch.Tensor, nvec: torch.Tensor, *, num_agents: int, num_individual_actions_features: int, validate_args=None):\n",
        "        self.batch_shape_prefix = logits.shape[:-1]\n",
        "        self.device = logits.device\n",
        "        # Ensure nvec_from_spec is of integer type\n",
        "        self.nvec_from_spec = nvec.to(self.device).to(torch.int64)\n",
        "        self.num_agents = num_agents\n",
        "        self.num_individual_actions_features = num_individual_actions_features\n",
        "\n",
        "        num_action_categories = int(self.nvec_from_spec.flatten()[0].item())\n",
        "        self.total_num_categorical_dists = self.num_agents * self.num_individual_actions_features\n",
        "\n",
        "        logits_reshaped = logits.view(*self.batch_shape_prefix, self.total_num_categorical_dists, num_action_categories)\n",
        "        self.dists = tdists.Categorical(logits=logits_reshaped, validate_args=validate_args)\n",
        "\n",
        "        super().__init__(batch_shape=self.batch_shape_prefix, event_shape=torch.Size([self.total_num_categorical_dists]), validate_args=validate_args)\n",
        "\n",
        "    def log_prob(self, value):\n",
        "        # Explicitly return log_prob tensor to avoid iteration errors\n",
        "        return self.dists.log_prob(value).sum(dim=-1)\n",
        "\n",
        "    def entropy(self):\n",
        "        return self.dists.entropy().sum(dim=-1)\n",
        "\n",
        "    def sample(self, sample_shape=torch.Size()):\n",
        "        # Call sample() on the internal dist and return the resulting tensor\n",
        "        return self.dists.sample(sample_shape)\n",
        "\n",
        "    def rsample(self, sample_shape=torch.Size()):\n",
        "        return self.dists.sample(sample_shape)\n",
        "\n",
        "    @property\n",
        "    def mode(self):\n",
        "        return self.dists.probs.argmax(dim=-1)\n",
        "\n",
        "    @property\n",
        "    def mean(self):\n",
        "        return torch.sum(self.dists.probs * torch.arange(self.dists.probs.shape[-1], device=self.device), dim=-1)"
      ],
