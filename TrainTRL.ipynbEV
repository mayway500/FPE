    {
      "cell_type": "code",
      "source": [
        "import torchrl\n",
        "import tensordict\n",
        "print(f\"torchrl version: {torchrl.__version__}\")\n",
        "print(f\"tensordict version: {tensordict.__version__}\")\n",
        "\n",
        "# Robust import for SyncDataCollector\n",
        "try:\n",
        "    from torchrl.collectors import SyncDataCollector\n",
        "    print(\"Imported from torchrl.collectors\")\n",
        "except ImportError:\n",
        "    try:\n",
        "        from torchrl.collectors.collectors import SyncDataCollector\n",
        "        print(\"Imported from torchrl.collectors.collectors\")\n",
        "    except ImportError:\n",
        "        from torchrl.collectors import Collector as SyncDataCollector\n",
        "        print(\"Imported Collector as SyncDataCollector from torchrl.collectors\")\n",
        "\n",
        "print(f\"SyncDataCollector is ready to use: {SyncDataCollector}\")"
