      "cell_type": "code",
      "source": [
        "from torchrl.modules import ValueOperator\n",
        "from tensordict.nn import TensorDictModule\n",
        "\n",
        "def build_models(observation_spec, action_spec, hidden_rnn_dim, gcn_hidden_dim, actual_num_agents, input_x_feature_dim_env, num_action_categories, num_individual_actions_features, forecast_horizon, device, num_gcn_layers, num_rnn_layers):\n",
        "    # 1. Instantiate the CombinedPolicyForecastingBase network\n",
        "    combined_net_base = CombinedPolicyForecastingBase(\n",
        "        observation_spec=observation_spec,\n",
        "        action_spec=action_spec,\n",
        "        hidden_rnn_dim=hidden_rnn_dim,\n",
        "        gcn_hidden_dim=gcn_hidden_dim,\n",
        "        num_agents=actual_num_agents,\n",
        "        input_x_dim=input_x_feature_dim_env,\n",
        "        num_action_categories=num_action_categories,\n",
        "        num_individual_actions_features=num_individual_actions_features,\n",
        "        forecast_horizon=forecast_horizon,\n",
        "        device=device,\n",
        "        num_gcn_layers=num_gcn_layers,\n",
        "        num_rnn_layers=num_rnn_layers\n",
        "    ).to(device)\n",
        "\n",
        "    # 2. Wrap it with CombinedActorForecasterModule for TorchRL compatibility\n",
        "    # This module handles the creation of distribution and sampling\n",
        "    leaf_action_spec = action_spec[\"agents\", \"action\"]\n",
        "    actor_forecaster = CombinedActorForecasterModule(\n",
        "        combined_net=combined_net_base,\n",
        "        action_spec=leaf_action_spec,\n",
        "        distribution_class=Custom_MultiCategorical,\n",
        "        distribution_kwargs={\n",
        "            \"nvec\": leaf_action_spec.nvec,\n",
        "            \"num_agents\": actual_num_agents,\n",
        "            \"num_individual_actions_features\": num_individual_actions_features\n",
        "        }\n",
        "    )\n",
        "\n",
        "    # 3. Initialize the Value operator for PPO/Critic updates\n",
        "    critic_net = ValueBase(\n",
        "        observation_spec, hidden_rnn_dim, gcn_hidden_dim, actual_num_agents,\n",
        "        input_x_feature_dim_env, device, num_gcn_layers, num_rnn_layers\n",
        "    ).to(device)\n",
        "    critic = ValueOperator(\n",
        "        module=critic_net,\n",
        "        in_keys=[(\"agents\", \"data\", \"x\"), (\"agents\", \"data\", \"edge_index\"), (\"agents\", \"data\", \"batch\"), (\"agents\", \"data\", \"time\"), (\"agents\", \"data\", \"graph_attributes\"), \"hidden_state_value\"],\n",
        "        out_keys=[\"state_value\", \"hidden_state_value\"]\n",
        "    )\n",
        "    return actor_forecaster, critic\n",
        "\n",
        "print(\"build_models function is ready.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "18oUSKrh0UJ8",
        "outputId": "a610ca55-c06d-4c35-f2ff-e20fa825f573"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "build_models function is ready.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from tensordict.nn import TensorDictModuleBase\n",
        "\n",
        "class CombinedActorForecasterModule(TensorDictModuleBase):\n",
        "    def __init__(self, combined_net, action_spec, distribution_class, distribution_kwargs):\n",
        "        super().__init__()\n",
        "        self.in_keys = [(\"agents\", \"data\", \"x\"), (\"agents\", \"data\", \"edge_index\"), (\"agents\", \"data\", \"batch\"), (\"agents\", \"data\", \"time\"), (\"agents\", \"data\", \"graph_attributes\"), \"hidden_state\"]\n",
        "        self.out_keys = [(\"agents\", \"logits\"), \"forecast\", \"hidden_state\", (\"agents\", \"action\"), \"sample_log_prob\"]\n",
        "\n",
        "        self.combined_net = combined_net\n",
        "        self.action_spec = action_spec\n",
        "        self.distribution_class = distribution_class\n",
        "        self.distribution_kwargs = distribution_kwargs\n",
        "\n",
        "    def forward(self, tensordict):\n",
        "        # 1. Single forward pass for backbone + both heads\n",
        "        logits, forecast, h_out = self.combined_net(\n",
        "            x=tensordict.get((\"agents\", \"data\", \"x\")),\n",
        "            edge_index=tensordict.get((\"agents\", \"data\", \"edge_index\")),\n",
        "            batch_nodes=tensordict.get((\"agents\", \"data\", \"batch\")),\n",
        "            time=tensordict.get((\"agents\", \"data\", \"time\")),\n",
        "            graph_attributes=tensordict.get((\"agents\", \"data\", \"graph_attributes\")),\n",
        "            hidden_state_in=tensordict.get(\"hidden_state\")\n",
        "        )\n",
        "\n",
        "        # 2. Create distribution and sample action\n",
        "        dist = self.distribution_class(logits=logits, **self.distribution_kwargs)\n",
        "\n",
        "        import torchrl\n",
        "        from torchrl.envs.utils import ExplorationType, exploration_type\n",
        "        curr_exploration = exploration_type()\n",
        "\n",
        "        if curr_exploration == ExplorationType.MODE:\n",
        "            action = dist.mode\n",
        "        else:\n",
        "            action = dist.sample()\n",
        "\n",
        "        # 3. Populate TensorDict\n",
        "        tensordict.set((\"agents\", \"logits\"), logits)\n",
        "        tensordict.set(\"forecast\", forecast)\n",
        "        tensordict.set(\"hidden_state\", h_out)\n",
        "        tensordict.set((\"agents\", \"action\"), action)\n",
        "        tensordict.set(\"sample_log_prob\", dist.log_prob(action))\n",
        "\n",
        "        return tensordict"
      ],
      "metadata": {
        "id": "uQ9y7TU60czI"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def train_agent_optimized(trial, lr, hidden_rnn_dim, gcn_hidden_dim, num_gcn_layers, num_rnn_layers, clip_epsilon, entropy_coeff, critic_coeff, minibatch_size, num_epochs, seed, node_features_tensors_dict, graph_attributes_tensor, device, num_envs, num_individual_actions_features, num_action_categories, forecast_horizon, frames_per_batch, total_frames, max_grad_norm, gamma, lmbda, episode_length, allow_repeat_data, data_path, checkpoint_dir, project_name, log_interval, force_data_reload, max_dataset_size):\n",
        "    from torchrl.envs import TransformedEnv\n",
        "    from torchrl.envs.transforms import InitTracker, TensorDictPrimer\n",
        "    from torchrl.objectives import ClipPPOLoss\n",
        "    from torchrl.objectives.value import MultiAgentGAE\n",
        "    from torchrl.collectors import SyncDataCollector\n",
        "    import torch.optim as optim\n",
        "\n",
        "    fuel_env_graph = FuelpriceenvfeatureGraph(node_features_tensors_dict, graph_attributes_tensor, forecast_horizon, device)\n",
        "\n",
        "    base_env = AnFuelpriceEnv(\n",
        "        data_tensor=fuel_env_graph.get_processed_data_tensor(),\n",
        "        num_envs=num_envs, seed=seed, device=device, episode_length=episode_length,\n",
        "        num_agents=fuel_env_graph.num_agents, num_individual_actions_features=num_individual_actions_features,\n",
        "        num_action_categories=num_action_categories, hidden_rnn_dim=hidden_rnn_dim,\n",
        "        num_rnn_layers=num_rnn_layers, forecast_horizon=forecast_horizon,\n",
        "        batch_size=torch.Size([num_envs]), w1=1.0, w2=0.1, w3=0.1, w4=0.1\n",
        "    )\n",
        "\n",
        "    env = TransformedEnv(base_env)\n",
        "    env.append_transform(TensorDictPrimer({\n",
        "        \"hidden_state\": Unbounded(shape=(1, num_rnn_layers, hidden_rnn_dim)),\n",
        "        \"hidden_state_value\": Unbounded(shape=(1, num_rnn_layers, hidden_rnn_dim)),\n",
        "    }, default_value=0, expand_specs=True))\n",
        "    env.append_transform(InitTracker())\n",
        "\n",
        "    actor_forecaster, critic = build_models_optimized(\n",
        "        env.observation_spec, env.action_spec, hidden_rnn_dim, gcn_hidden_dim,\n",
        "        fuel_env_graph.num_agents, fuel_env_graph.max_feat_dim, num_action_categories,\n",
        "        num_individual_actions_features, forecast_horizon, device, num_gcn_layers, num_rnn_layers\n",
        "    )\n",
        "\n",
        "    loss_module = ClipPPOLoss(actor=actor_forecaster, critic=critic, clip_epsilon=clip_epsilon, entropy_coeff=entropy_coeff, critic_coeff=critic_coeff)\n",
        "    loss_module.set_keys(reward=\"reward\", sample_log_prob=\"sample_log_prob\")\n",
        "\n",
        "    adv_module = MultiAgentGAE(gamma=gamma, lmbda=lmbda, value_network=critic, average_gae=True)\n",
        "    adv_module.set_keys(reward=\"reward\")\n",
        "\n",
        "    optimizer_actor_critic = optim.Adam(loss_module.parameters(), lr=lr)\n",
        "    underlying_model = actor_forecaster[0].module\n",
        "    optimizer_forecaster = optim.Adam(underlying_model.forecast_head.parameters(), lr=lr)\n",
        "\n",
        "    collector = SyncDataCollector(env, actor_forecaster, frames_per_batch=frames_per_batch, total_frames=total_frames, device=device, storing_device=device)\n",
        "\n",
        "    total_reward, num_batches = 0, 0\n",
        "    try:\n",
        "        for i, tensordict_data in enumerate(collector):\n",
        "            if (\"next\", \"reward\") in tensordict_data.keys(include_nested=True):\n",
        "                tensordict_data.set(\"reward\", tensordict_data.get((\"next\", \"reward\")))\n",
        "            if \"sample_log_prob\" not in tensordict_data.keys():\n",
        "                if (\"agents\", \"action_log_prob\") in tensordict_data.keys(include_nested=True):\n",
        "                    tensordict_data.set(\"sample_log_prob\", tensordict_data.get((\"agents\", \"action_log_prob\")))\n",
        "\n",
        "            current_metrics = {k: tensordict_data[\"next\", k].mean().item() for k in ['profit_term_mean', 'volatility_term_mean', 'forecast_term_mean', 'graph_term_global_mean']}\n",
        "            adjust_weights_dynamically(base_env, current_metrics, i, adjustment_interval=10, weight_lr=0.005)\n",
        "\n",
        "            f_loss = train_forecaster_step(tensordict_data, underlying_model, optimizer_forecaster, fuel_env_graph.num_agents, fuel_env_graph.max_feat_dim, i, wandb)\n",
        "            a_loss, c_loss, e_loss = train_ppo_step(tensordict_data, adv_module, loss_module, optimizer_actor_critic, num_epochs, minibatch_size, max_grad_norm, i, wandb)\n",
        "\n",
        "            total_reward += current_metrics['profit_term_mean']\n",
        "            num_batches += 1\n",
        "            if i % log_interval == 0:\n",
        "                wandb.log({\"actor_loss\": a_loss, \"critic_loss\": c_loss, \"entropy_loss\": e_loss, \"forecaster_loss\": f_loss}, step=i)\n",
        "    finally:\n",
        "        collector.shutdown()\n",
        "\n",
        "    return {\"mean_reward\": total_reward / num_batches if num_batches > 0 else 0.0}"
      ],
      "metadata": {
        "id": "rmznnh2l0mDB"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Instantiate the optimized models globally for testing and verification # Re-instantiating models\n",
        "actor_forecaster, critic = build_models(\n",
        "    observation_spec=env.observation_spec,\n",
        "    action_spec=env.action_spec,\n",
        "    hidden_rnn_dim=hidden_rnn_dim,\n",
        "    gcn_hidden_dim=gcn_hidden_dim,\n",
        "    actual_num_agents=num_agents,\n",
        "    input_x_feature_dim_env=input_x_dim,\n",
        "    num_action_categories=num_action_categories,\n",
        "    num_individual_actions_features=num_individual_actions_features,\n",
        "    forecast_horizon=forecast_horizon,\n",
        "    device=device,\n",
        "    num_gcn_layers=num_gcn_layers,\n",
        "    num_rnn_layers=num_rnn_layers\n",
        ")\n",
        "print(\"actor_forecaster and critic instantiated in global scope.\")"
      ],
