            "  Node 'European Union' tensor shape: torch.Size([3103, 224])\n",
            "  Node 'Ghana' tensor shape: torch.Size([3103, 2])\n",
            "  Node 'USA' tensor shape: torch.Size([3103, 9])\n",
            "  Node 'Australia' tensor shape: torch.Size([3103, 16])\n",
            "  Node 'Lesotho' tensor shape: torch.Size([3103, 4])\n",
            "Graph attributes tensor shape: torch.Size([3103, 3])\n",
            "DataPreprocessor updated and validated.\n"
          ]
        }
