    {
      "cell_type": "code",
      "source": [
        "import optuna\n",
        "import wandb\n",
        "import torch\n",
        "\n",
        "if 'device' not in globals():\n",
        "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "\n",
        "data_path = nanayaw56_combined_fuel_data_path\n",
        "forecast_horizon = 7\n",
        "\n",
        "def objective(trial: optuna.Trial) -> float:\n",
        "    # Hyperparameters suggested by the user\n",
        "    hidden_rnn_dim = trial.suggest_int('hidden_rnn_dim', 32, 128)\n",
        "    gcn_hidden_dim = trial.suggest_int('gcn_hidden_dim', 32, 128)\n",
        "    num_gcn_layers = trial.suggest_int('num_gcn_layers', 1, 3)\n",
        "    num_rnn_layers = trial.suggest_int('num_rnn_layers', 1, 2)\n",
        "    lr = trial.suggest_float('lr', 1e-5, 1e-3, log=True)\n",
        "    clip_epsilon = trial.suggest_float('clip_epsilon', 0.1, 0.3)\n",
        "    entropy_coeff = trial.suggest_float('entropy_coeff', 1e-3, 1e-2, log=True)\n",
        "    critic_coeff = trial.suggest_float('critic_coeff', 0.5, 2.0)\n",
        "    trial_seed = trial.suggest_int('seed', 0, 100000)\n",
        "\n",
        "    # Parameters for collector\n",
        "    num_workers = 4\n",
        "    frames_per_batch = 128\n",
        "    total_frames = 10000\n",
        "    max_grad_norm = 0.5\n",
        "\n",
        "    cfg = {\n",
        "        \"num_workers\": num_workers,\n",
        "        \"lr\": lr,\n",
        "        \"hidden_dim\": hidden_rnn_dim,\n",
        "        \"gcn_hidden_dim\": gcn_hidden_dim,\n",
        "        \"num_gcn_layers\": num_gcn_layers,\n",
        "        \"num_rnn_layers\": num_rnn_layers,\n",
        "        \"frames_per_batch\": frames_per_batch,\n",
        "        \"total_frames\": total_frames,\n",
        "        \"clip_epsilon\": clip_epsilon,\n",
        "        \"entropy_coeff\": entropy_coeff,\n",
        "        \"critic_coeff\": critic_coeff,\n",
        "        \"max_grad_norm\": max_grad_norm,\n",
        "        \"seed\": trial_seed\n",
        "    }\n",
        "\n",
        "    wandb.init(\n",
        "        project=\"MARL_Fuel_StabilizationA\",\n",
        "        group=\"parallel_optuna_study\",\n",
        "        name=f\"trial-{trial.number}\",\n",
        "        config=cfg,\n",
        "        reinit=True\n",
        "    )\n",
        "\n",
        "    try:\n",
        "        # Call the parallel training function defined earlier\n",
        "        mean_reward = train_multi_agent_parallel(\n",
        "            cfg=cfg,\n",
        "            device=device,\n",
        "            node_features=data_preprocessor.node_features_tensors,\n",
        "            graph_attrs=data_preprocessor.graph_attributes_tensor\n",
        "        )\n",
        "        return mean_reward\n",
        "    finally:\n",
        "        wandb.finish()\n",
        "\n",
        "study = optuna.create_study(direction=\"maximize\")\n",
        "study.optimize(objective, n_trials=50)"
      ],
